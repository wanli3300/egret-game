<!DOCTYPE html>
<html lang="zh-CN" class="egret-booting">
<head>
<meta charset="UTF-8">
<style id="startup-guard">html.egret-booting,html.egret-booting body{background:#000!important}html.egret-booting::after{content:'';position:fixed;inset:0;z-index:2147483647;background:#000;pointer-events:auto}</style>
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>白鹭击浪</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#1a1a18;}
  /* ★ 舞台自适应：逻辑画布 1280×640，整体等比缩放铺满窗口（画布与所有 DOM UI 一起放大） */
  #wrap{position:fixed;left:50%;top:50%;width:1280px;height:640px;
        transform:translate(-50%,-50%) scale(var(--fit,1));transform-origin:50% 50%;
        overflow:hidden;}
  canvas{background:#efece0;box-shadow:0 0 60px rgba(0,0,0,.6);cursor:crosshair;}
  /* HUD 全部用 DOM 叠在画布上，方便以后改样式 */
  #hud{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;
       font-family:"Courier New",monospace;}
  /* ---- 战斗 HUD·纸上物（笺纸标签 + 笔触条 + 印章） ---- */
  #hud{font-family:"KaiTi","STKaiti","FZKaiTi","SimSun",serif;}
  #stats{position:absolute;left:24px;top:18px;padding:10px 16px 12px;
         background:rgba(250,247,238,.82);border:1.5px solid rgba(46,79,87,.55);
         border-radius:4px;box-shadow:0 3px 10px rgba(46,79,87,.10);}
  #stats::before{content:'鹭';position:absolute;left:-11px;top:-11px;width:24px;height:24px;
         background:#b03a2e;color:#f7f3e8;font-size:13px;line-height:24px;text-align:center;
         border-radius:3px;box-shadow:0 0 0 2px #f7f3e8,0 0 0 3px rgba(176,58,46,.4);
         transform:rotate(-6deg);}
  #statName{font-size:15px;letter-spacing:3px;color:#2e4f57;font-weight:bold;margin-bottom:7px;}
  .bar{width:238px;height:15px;border:1.5px solid rgba(46,79,87,.6);border-radius:8px;
       margin-bottom:6px;position:relative;background:rgba(46,79,87,.10);overflow:hidden;}
  .bar .fill{height:100%;transition:width .3s cubic-bezier(.3,.7,.3,1);}
  #hpFill{background:linear-gradient(90deg,#8f2f25,#c9564a);box-shadow:inset 0 1px 0 rgba(255,255,255,.35);}
  #mpFill{background:linear-gradient(90deg,#2e4f57,#5b8a90);box-shadow:inset 0 1px 0 rgba(255,255,255,.3);}
  .barNum{position:absolute;left:10px;top:0;font-size:10px;color:#f7f3e8;line-height:15px;
          font-family:Georgia,"KaiTi",serif;letter-spacing:1px;text-shadow:0 1px 2px rgba(0,0,0,.45);}
  #aspeed{font-size:12px;color:rgba(46,79,87,.75);margin-top:6px;letter-spacing:1px;}
  /* ★ 进度/强化列固定在笺纸面板右侧（面板右缘 ≈ x297，留 20px 间隙），避免与血条栏重叠 */
  #kills{position:absolute;left:318px;top:20px;font-size:24px;color:#2e4f57;font-weight:bold;
         letter-spacing:2px;font-family:Georgia,"KaiTi",serif;
         text-shadow:0 1px 0 rgba(247,243,232,.9);}
  #kills::after{content:'破 浪';display:block;font-size:11px;color:rgba(46,79,87,.6);letter-spacing:6px;margin-top:1px;}
  #lvlBuffs{position:absolute;left:318px;top:92px;display:flex;flex-wrap:wrap;gap:5px;
            max-width:calc(100% - 340px);}
  #combo{position:absolute;left:50%;bottom:48px;transform:translateX(-50%) rotate(-2deg);
         color:#f7f3e8;background:#b03a2e;border-radius:4px;padding:6px 30px;font-size:17px;letter-spacing:5px;
         box-shadow:inset 0 0 0 2px #f7f3e8,0 4px 12px rgba(176,58,46,.35);
         opacity:0;transition:opacity .2s;font-weight:bold;}
  #waveTitle{position:absolute;left:50%;top:36%;transform:translate(-50%,-50%);
         color:#2e4f57;font-size:34px;letter-spacing:12px;opacity:0;transition:opacity .35s;
         font-weight:bold;text-shadow:0 2px 14px rgba(243,238,227,.9);}
  #tip{position:absolute;right:18px;bottom:12px;font-size:12px;color:rgba(46,79,87,.5);letter-spacing:1px;}
  #vignette{position:absolute;inset:0;pointer-events:none;z-index:5;
            background:radial-gradient(ellipse at center, transparent 52%, rgba(46,79,87,.15) 100%);}

  /* ================= 页面与覆盖层 ================= */
  .screen{position:absolute;inset:0;display:none;flex-direction:column;
          align-items:center;justify-content:center;gap:22px;
          background:rgba(239,236,224,.94);font-family:"KaiTi","STKaiti","FZKaiTi","SimSun",serif;
          pointer-events:auto;}
  .screen.active{display:flex;}
  .gameTitle{font-size:46px;letter-spacing:14px;color:#1d1d1b;font-weight:bold;}
  .gameSub{font-size:13px;letter-spacing:6px;color:#8a8578;margin-top:-14px;}
  /* ---- 通用按钮：纸签（无边框，靠内描边 + 底影做厚度） ---- */
  .btn{border:none;background:linear-gradient(180deg,#fdfbf4 0%,#f3eedf 100%);color:#2e4f57;
       font-family:inherit;font-size:15px;letter-spacing:4px;padding:12px 44px;
       cursor:pointer;transition:all .15s;min-width:220px;border-radius:2px;
       box-shadow:inset 0 0 0 1px rgba(46,79,87,.45),0 3px 9px rgba(46,79,87,.10);}
  .btn:hover{background:linear-gradient(180deg,#2e4f57 0%,#24424a 100%);color:#f7f3e8;transform:translateY(-1px);
             box-shadow:inset 0 0 0 1px rgba(247,243,232,.25),0 6px 15px rgba(46,79,87,.22);}
  .btn.primary{background:linear-gradient(180deg,#b8433a 0%,#9c2f26 100%);color:#fff;
             box-shadow:inset 0 0 0 1px rgba(247,243,232,.28),0 3px 9px rgba(176,58,46,.25);}
  .btn.primary:hover{background:linear-gradient(180deg,#9c2f26 0%,#82251d 100%);}
  .menuBtns{display:flex;flex-direction:column;gap:12px;margin-top:6px;}
  /* 存档行 */
  .saveRow{display:flex;gap:8px;align-items:center;margin:2px 0 6px;}
  #saveName{width:186px;padding:8px 10px;border:2px solid #1d1d1b;background:rgba(255,255,255,.5);
            font-family:"Courier New",monospace;font-size:13px;color:#1d1d1b;outline:none;}
  #saveName:focus{background:#fff;}
  .note{font-size:12px;color:#b03a2e;opacity:0;transition:opacity .3s;max-width:460px;text-align:center;}

  /* 选关·鹭岛长卷：12 张签牌沿浪线起伏排列 */
  .selHead{font-size:30px;letter-spacing:16px;text-indent:16px;color:#2e4f57;font-weight:bold;}
  .selSub{font-size:13px;letter-spacing:7px;text-indent:7px;color:rgba(46,79,87,.62);margin-top:-14px;}
  .lvGridWrap{position:relative;display:flex;align-items:flex-end;justify-content:center;
              width:min(1180px,94vw);padding:12px 0 18px;}
  /* 贯穿整卷的浪线 */
  .lvGridWrap::after{content:'';position:absolute;left:0;right:0;bottom:4px;height:14px;pointer-events:none;
        background:no-repeat center/100% 100%;
        background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1200 14' preserveAspectRatio='none'><path d='M0 8 Q 30 1 60 8 T 120 8 T 180 8 T 240 8 T 300 8 T 360 8 T 420 8 T 480 8 T 540 8 T 600 8 T 660 8 T 720 8 T 780 8 T 840 8 T 900 8 T 960 8 T 1020 8 T 1080 8 T 1140 8 T 1200 8' fill='none' stroke='%232e4f57' stroke-width='1.4' opacity='.36'/></svg>");}
  .lvGrid{display:flex;align-items:flex-end;justify-content:center;gap:9px;position:relative;z-index:1;}
  .lvCard{position:relative;flex:0 0 auto;width:88px;height:158px;cursor:pointer;overflow:hidden;
          border:1px solid rgba(46,79,87,.5);border-radius:2px;text-align:center;
          background-color:#ded9c9;background-size:cover;background-position:center;
          box-shadow:0 3px 10px rgba(46,79,87,.15);
          transition:transform .16s,box-shadow .16s,border-color .16s;}
  .lvCard::after{content:'';position:absolute;inset:0;pointer-events:none;
          background:linear-gradient(180deg,rgba(247,243,232,.80) 0%,rgba(247,243,232,.34) 34%,rgba(247,243,232,.42) 62%,rgba(247,243,232,.90) 100%);}
  .lvCard:hover{transform:translateY(-6px);border-color:#2e4f57;box-shadow:0 10px 20px rgba(46,79,87,.22);}
  .lvCard.locked{opacity:.5;cursor:not-allowed;border-color:rgba(46,79,87,.28);box-shadow:none;filter:grayscale(1);}
  .lvCard.locked::after{background:rgba(247,243,232,.66);}
  /* 当前可挑战关：朱砂印高亮 */
  .lvCard.now{border-color:#b03a2e;box-shadow:0 0 0 2px rgba(176,58,46,.34),0 7px 16px rgba(176,58,46,.20);}
  .lvCard.now::before{content:'今';position:absolute;right:4px;top:4px;z-index:3;
          width:22px;height:22px;background:#b03a2e;color:#f7f3e8;font-size:13px;line-height:22px;
          text-align:center;border-radius:2px;transform:rotate(-6deg);
          box-shadow:inset 0 0 0 1px rgba(247,243,232,.75);}
  /* 关号：左上朱砂角签 */
  .lvNo{position:absolute;left:0;top:0;z-index:2;
        font-family:Georgia,"KaiTi",serif;font-size:15px;font-weight:bold;color:#f7f3e8;
        background:#b03a2e;padding:1px 7px 3px;letter-spacing:1px;}
  .lvCard.locked .lvNo{background:#8a8b84;}
  /* 关名：竖排（卷轴感） */
  .lvName{position:absolute;left:50%;top:14px;transform:translateX(-50%);z-index:2;
          writing-mode:vertical-rl;text-orientation:upright;
          font-size:15px;font-weight:bold;color:#2e4f57;letter-spacing:4px;
          text-shadow:0 0 5px #f7f3e8,0 0 5px #f7f3e8,0 0 6px #f7f3e8;}
  .lvState{position:absolute;left:0;right:0;bottom:8px;z-index:2;
          font-size:10px;letter-spacing:1px;color:#4a5a55;
          text-shadow:0 0 4px #f7f3e8,0 0 4px #f7f3e8;}

  /* 覆盖层 */
  #overlay{position:absolute;inset:0;display:none;flex-direction:column;
           align-items:center;justify-content:center;gap:16px;
           background:rgba(243,238,227,.96);font-family:"KaiTi","STKaiti","FZKaiTi","SimSun",serif;
           z-index:20;pointer-events:auto;}
  #overlay.active{display:flex;animation:ovIn .32s ease-out;}
  @keyframes ovIn{from{opacity:0;}to{opacity:1;}}
  #ovTag{font-size:14px;letter-spacing:10px;color:#b03a2e;font-weight:bold;}
  #ovTitle{font-size:34px;letter-spacing:5px;color:#2e4f57;font-weight:bold;}
  #ovSub{font-size:14px;color:#84806f;letter-spacing:2px;}
  #ovBtns{display:flex;gap:12px;margin-top:12px;flex-wrap:wrap;justify-content:center;}
  #ovBtns .btn{min-width:150px;padding:11px 24px;font-size:14px;}
  /* 暂停页音量控件 */
  #audioRow{display:none;align-items:center;gap:12px;margin-top:6px;}
  #audioRow.show{display:flex;}
  .auLabel{font-size:12px;letter-spacing:3px;color:#5a5648;}
  /* 音量滑杆 → 笔杆 + 朱砂滑钮 */
  #volRange{-webkit-appearance:none;appearance:none;width:180px;height:3px;
            background:rgba(46,79,87,.35);border-radius:2px;outline:none;cursor:pointer;}
  #volRange::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;
            background:#b03a2e;border:2px solid #f7f3e8;box-shadow:0 1px 4px rgba(176,58,46,.4);cursor:pointer;}
  .btn.small{min-width:auto;padding:7px 16px;font-size:12px;letter-spacing:1px;}

  /* HUD 按需显示 */
  #hud{opacity:0;transition:opacity .2s;}
  #hud.show{opacity:1;}
  #btnPause{pointer-events:auto;position:absolute;right:22px;top:20px;
            border:1.5px solid rgba(46,79,87,.65);background:rgba(250,247,238,.85);color:#2e4f57;
            font-family:"KaiTi","STKaiti",serif;font-size:14px;letter-spacing:4px;
            padding:6px 18px;cursor:pointer;border-radius:6px;transition:all .15s;
            box-shadow:0 2px 8px rgba(46,79,87,.12);}
  #btnPause:hover{background:#2e4f57;color:#f7f3e8;}

  /* ================= 升级卡片 ================= */
  .buffChip{font-size:12px;letter-spacing:1px;color:#2e4f57;border:1px solid rgba(46,79,87,.55);
            padding:2px 8px;background:rgba(46,79,87,.07);border-radius:3px;}
  /* ===== 升级卡片·国风令牌（按用户设计图，仅 cardLayer） ===== */
  #cardLayer{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;
             justify-content:center;gap:24px;background:rgba(243,238,227,.88);
             font-family:"KaiTi","STKaiti","FZKaiTi","SimSun",serif;z-index:30;pointer-events:auto;
             overflow:hidden;}
  /* 模糊水彩背景：当前关卡图（JS 注入 --cardBg） */
  #cardLayer::before{content:'';position:absolute;inset:-30px;background-image:var(--cardBg,none);
             background-size:cover;background-position:center;filter:blur(9px) brightness(1.05);
             opacity:.55;pointer-events:none;}
  #cardLayer.active{display:flex;}
  #cardLayer>*{position:relative;z-index:1;}
  #cardHead{font-size:42px;letter-spacing:20px;text-indent:20px;color:#2e4f57;font-weight:900;}
  #cardSub{font-size:15px;letter-spacing:6px;color:#84806f;margin-top:-16px;}
  #cardRow{display:flex;gap:28px;}
  /* 入场动画：用 forwards 保证动画后停在可见状态；
     不用 backwards（它会在延迟期把元素强制 opacity:0，一旦动画未执行卡片就永久透明点不到） */
  @keyframes cardPop{from{opacity:0;transform:translateY(26px) scale(.94);}to{opacity:1;transform:none;}}
  .upCard{width:212px;height:312px;border-radius:20px;border:2px solid var(--c,#1d1d1b);
          background:linear-gradient(168deg,var(--c-bg,#f4f1e6) 0%,#fdfcf8 46%,var(--c-bg,#f4f1e6) 100%);
          display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
          padding:24px 16px;cursor:pointer;transition:transform .18s,box-shadow .18s;
          box-sizing:border-box;opacity:1;animation:cardPop .3s ease-out forwards;position:relative;
          box-shadow:0 8px 22px rgba(60,70,80,.14);}
  /* 内层细边框（双线框） */
  .upCard::after{content:'';position:absolute;inset:6px;border:1px solid var(--c-soft,#8a8578);
          border-radius:14px;pointer-events:none;}
  .upCard:nth-child(1){animation-delay:.05s;}
  .upCard:nth-child(2){animation-delay:.13s;}
  .upCard:nth-child(3){animation-delay:.21s;}
  .upCard:hover{transform:translateY(-10px) scale(1.02);box-shadow:0 16px 30px rgba(46,79,87,.22);}
  /* 稀有度配色：普通=蓝 · 稀有=紫 · 史诗=红 */
  .upCard.rare-普通{--c:#4a7ba6;--c-deep:#2d5a7a;--c-soft:#93aec8;--c-bg:#e4eef7;--c-pill:#cfe0ee;}
  .upCard.rare-稀有{--c:#8a6bab;--c-deep:#5f4187;--c-soft:#ab93c8;--c-bg:#eae3f5;--c-pill:#ddd0ef;}
  .upCard.rare-史诗{--c:#b8433a;--c-deep:#a03330;--c-soft:#cd8b84;--c-bg:#f7e5df;--c-pill:#f2d1ca;}
  /* 四角云纹角饰（SVG mask，颜色随稀有度变量） */
  .cCorner{position:absolute;width:30px;height:30px;background:var(--c,#1d1d1b);
           pointer-events:none;z-index:2;
    -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 34 34'><g fill='none' stroke='black' stroke-width='2' stroke-linecap='round'><path d='M3 31 L3 14 Q3 3 14 3 L31 3'/><path d='M10 31 L10 17 Q10 10 17 10 L31 10' opacity='.55'/><path d='M3 31 Q9 31 9 25 Q9 21 5.5 21.5' opacity='.9'/></g></svg>") center/contain no-repeat;
    mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 34 34'><g fill='none' stroke='black' stroke-width='2' stroke-linecap='round'><path d='M3 31 L3 14 Q3 3 14 3 L31 3'/><path d='M10 31 L10 17 Q10 10 17 10 L31 10' opacity='.55'/><path d='M3 31 Q9 31 9 25 Q9 21 5.5 21.5' opacity='.9'/></g></svg>") center/contain no-repeat;}
  .cCorner.tl{top:10px;left:10px;transform:rotate(90deg);}
  .cCorner.tr{top:10px;right:10px;transform:rotate(180deg);}
  .cCorner.br{bottom:10px;right:10px;transform:rotate(270deg);}
  .cCorner.bl{bottom:10px;left:10px;}
  .cRare{font-size:15px;letter-spacing:10px;text-indent:10px;color:var(--c-deep);margin:4px 0 0;}
  .cName{font-size:46px;letter-spacing:8px;text-indent:8px;color:var(--c-deep);font-weight:900;
         margin:12px 0 2px;line-height:1.15;text-align:center;}
  .cVal{margin-top:10px;font-size:13px;letter-spacing:3px;color:var(--c-deep);
        background:var(--c-pill);padding:4px 16px;border-radius:999px;}
  .cLine{width:46px;height:2px;background:var(--c-soft);margin:18px auto 12px;}
  .cDesc{font-size:16px;line-height:1.6;color:#3b3931;font-weight:bold;text-align:center;
         letter-spacing:1px;padding:0 2px;}
  #cardBtns{display:flex;gap:16px;align-items:center;}
  #btnRefresh{background:linear-gradient(180deg,#3d6b73 0%,#2c4d55 100%);color:#fff;border:none;
              font-weight:bold;letter-spacing:3px;padding:10px 34px;border-radius:2px;font-family:inherit;
              display:flex;align-items:center;gap:6px;
              box-shadow:inset 0 0 0 1px rgba(247,243,232,.25),0 3px 9px rgba(46,79,87,.20);}
  #btnRefresh:hover:not(:disabled){background:linear-gradient(180deg,#35606a 0%,#24424a 100%);}
  #btnRefresh:disabled,#btnRefresh.used{opacity:.42;cursor:not-allowed;
              background:transparent;color:#8a8578;box-shadow:inset 0 0 0 1px rgba(138,133,120,.6);}
  #cardSkip{background:linear-gradient(180deg,#fdfbf4 0%,#f3eedf 100%);color:#2e4f57;border:none;
            letter-spacing:3px;padding:10px 34px;border-radius:2px;
            box-shadow:inset 0 0 0 1px rgba(46,79,87,.45),0 3px 9px rgba(46,79,87,.10);}
  #cardSkip:hover{background:linear-gradient(180deg,#2e4f57 0%,#24424a 100%);color:#f7f3e8;}
  /* 版本/诊断角标 */
  #dbg{position:absolute;right:10px;top:4px;font-size:10px;color:rgba(29,29,27,.38);
       font-family:"Courier New",monospace;pointer-events:none;z-index:99;letter-spacing:1px;}

  /* ================= 首页·国风菜单（按用户设计图，仅作用于 #screen-menu） ================= */
  :root{ --ink:#2e4f57; --wave:#5b8a90; --paper:#f7f3e8; }
  #screen-menu{background:#e9e4d6;font-family:"KaiTi","STKaiti","FZKaiTi","SimSun",serif;overflow:hidden;}
  /* 背景水彩图（JS 塞鼓浪屿图）+ 米白薄纱 */
  #menuBgImg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
              filter:blur(7px) brightness(1.05) saturate(.92);transform:scale(1.06);}
  #screen-menu::before{content:'';position:absolute;inset:0;background:rgba(243,239,229,.45);pointer-events:none;}
  /* 四角海浪花纹 */
  .mCorner{position:absolute;width:150px;height:150px;pointer-events:none;opacity:.85;z-index:2;}
  .mCorner.tl{left:6px;top:6px;}
  .mCorner.tr{right:6px;top:6px;transform:rotate(90deg);}
  .mCorner.br{right:6px;bottom:6px;transform:rotate(180deg);}
  .mCorner.bl{left:6px;bottom:6px;transform:rotate(270deg);}
  /* 底部浪线 */
  .mWave{position:absolute;left:0;right:0;bottom:34px;width:100%;height:46px;pointer-events:none;opacity:.5;z-index:2;}
  /* 主体：左标题 右按钮 */
  .menuMain{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;
            width:100%;padding:0 92px;box-sizing:border-box;margin-top:-16px;}
  .titleArt{display:flex;flex-direction:column;line-height:.94;}
  .titleArt .tRow{display:flex;}
  .titleArt span{font-size:128px;font-weight:900;color:var(--ink);letter-spacing:10px;
                 text-shadow:4px 5px 0 rgba(63,110,122,.16), 0 0 26px rgba(247,243,232,.9);}
  .titleArt .up{transform:translateY(-16px);}
  .titleArt .down{transform:translateY(16px);}
  .titleSub{margin-top:20px;font-size:17px;letter-spacing:11px;color:var(--ink);opacity:.82;
            border-top:2px solid rgba(46,79,87,.35);padding-top:10px;width:max-content;}
  /* 按钮组 */
  .menuBtnsArt{display:flex;flex-direction:column;align-items:center;gap:17px;}
  /* ---- 首页按钮：纸签（宣纸条 + 笔锋下缘 + 左端朱砂小签） ---- */
  .abtn{position:relative;min-width:252px;height:54px;border:none;
        background:linear-gradient(180deg,#fcfaf3 0%,#f4efe1 100%);
        color:var(--ink);font-family:inherit;font-size:20px;font-weight:bold;
        letter-spacing:11px;text-indent:11px;cursor:pointer;
        box-shadow:inset 0 0 0 1px rgba(46,79,87,.38), 0 4px 11px rgba(46,79,87,.10);
        transition:transform .15s,box-shadow .15s,background .15s,color .15s;}
  /* 下缘笔锋：中间实、两端渐隐 */
  .abtn::after{content:'';position:absolute;left:4px;right:4px;bottom:-2px;height:3px;
        background:linear-gradient(90deg,transparent 0%,rgba(46,79,87,.55) 18%,#2e4f57 50%,rgba(46,79,87,.55) 82%,transparent 100%);
        transform:scaleX(.86);transition:transform .22s;}
  /* 左端朱砂小签 */
  .abtn::before{content:'';position:absolute;left:0;top:9px;bottom:9px;width:3px;
        background:#b03a2e;opacity:.72;transition:opacity .15s;}
  .abtn:hover{transform:translateY(-2px);
        background:linear-gradient(180deg,#fffdf7 0%,#f7f2e4 100%);
        box-shadow:inset 0 0 0 1px rgba(46,79,87,.62), 0 8px 18px rgba(46,79,87,.18);}
  .abtn:hover::after{transform:scaleX(1);}
  .abtn:active{transform:translateY(0);}
  .abtn.primary{background:linear-gradient(180deg,#3d6b73 0%,#2c4d55 100%);color:var(--paper);
        box-shadow:inset 0 0 0 1px rgba(247,243,232,.28), 0 4px 12px rgba(46,79,87,.22);}
  .abtn.primary::before{background:#f7f3e8;opacity:.55;}
  .abtn.primary::after{background:linear-gradient(90deg,transparent 0%,rgba(247,243,232,.5) 18%,#f7f3e8 50%,rgba(247,243,232,.5) 82%,transparent 100%);}
  .abtn.primary:hover{background:linear-gradient(180deg,#35606a 0%,#24424a 100%);}
  .abtnRow{display:flex;gap:16px;}
  .abtnRow .abtn{min-width:168px;height:47px;font-size:15px;letter-spacing:4px;text-indent:4px;padding:0 42px;}
  .abtn.tiny{min-width:0;height:40px;font-size:14px;letter-spacing:3px;text-indent:3px;padding:0 20px;}
  .abtn.tiny::before,.abtn.tiny::after{display:none;}
  /* 左下存档行 */
  /* 左下存档行：一体化纸签托盘（竖排朱砂标签 + 静音工具钮） */
  .saveRowArt{position:absolute;left:92px;bottom:40px;z-index:3;display:flex;gap:9px;align-items:center;
        padding:9px 16px 9px 11px;
        background:linear-gradient(180deg,rgba(252,250,243,.60),rgba(244,239,225,.74));
        box-shadow:inset 0 0 0 1px rgba(46,79,87,.28);border-radius:2px;}
  .saveRowArt .saveTag{writing-mode:vertical-rl;text-orientation:upright;font-size:12px;
        letter-spacing:3px;color:#b03a2e;font-weight:bold;opacity:.85;margin-right:3px;}
  .saveRowArt .abtn.tiny{height:34px;background:transparent;box-shadow:none;
        font-size:14px;letter-spacing:2px;padding:0 10px;color:var(--ink);opacity:.82;}
  .saveRowArt .abtn.tiny:hover{background:rgba(46,79,87,.10);opacity:1;transform:none;box-shadow:none;}
  .saveRowArt #saveName{width:176px;height:34px;padding:0 8px 2px;border:none;
        border-bottom:2px solid rgba(46,79,87,.55);
        background:transparent;
        font-family:inherit;font-size:15px;letter-spacing:2px;color:var(--ink);outline:none;
        transition:border-color .15s,background .15s;}
  .saveRowArt #saveName::placeholder{color:rgba(46,79,87,.40);letter-spacing:1px;font-size:14px;}
  .saveRowArt #saveName:focus{border-bottom-color:#b03a2e;background:rgba(255,253,247,.85);}
  /* 提示行 */
  #screen-menu .note{position:absolute;right:92px;bottom:44px;z-index:3;max-width:380px;text-align:right;
                     color:var(--ink);font-size:14px;letter-spacing:2px;}
  /* ================= 存档处页面 ================= */
  #screen-saves{background:#e9e4d6;font-family:"KaiTi","STKaiti","FZKaiTi","SimSun",serif;
                color:var(--ink);}
  #screen-saves .selHead{color:var(--ink);font-size:30px;letter-spacing:16px;text-indent:16px;}
  .saveList{display:flex;flex-direction:column;gap:12px;width:min(760px,86vw);
            max-height:48vh;overflow-y:auto;padding:4px 10px;box-sizing:border-box;}
  .saveCard{display:flex;flex-direction:column;gap:9px;padding:14px 20px;position:relative;
            border:1px solid rgba(46,79,87,.42);border-radius:3px;
            background:linear-gradient(180deg,#fdfcf8 0%,#f5f0e2 100%);
            box-shadow:0 2px 0 rgba(46,79,87,.10),0 6px 16px rgba(46,79,87,.08);}
  /* 最近读写的档：左侧朱砂书脊 */
  .saveCard.last{border-color:rgba(176,58,46,.50);}
  .saveCard.last::before{content:'';position:absolute;left:-1px;top:9px;bottom:9px;width:4px;
            background:#b03a2e;border-radius:2px;}
  .scHead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;}
  .scName{font-size:22px;font-weight:900;letter-spacing:3px;}
  .scMeta{font-size:13px;letter-spacing:1px;color:#65756f;}
  .scBuffs{display:flex;flex-wrap:wrap;gap:6px;}
  .scBuffs .buffChip{font-size:11px;border-color:var(--ink);color:var(--ink);
                     background:rgba(46,79,87,.07);padding:2px 8px;}
  .scNone{font-size:12px;color:#95a09a;letter-spacing:1px;}
  .scFoot{display:flex;justify-content:space-between;align-items:center;}
  .scTime{font-size:12px;color:#93998f;letter-spacing:1px;}
  .saveEmpty{font-size:15px;color:#847f6f;letter-spacing:2px;text-align:center;padding:28px 0;}
  .saveNewRow{display:flex;gap:11px;align-items:center;}
  .saveNewRow input{width:236px;height:40px;padding:0 10px 2px;border:none;
                    border-bottom:2px solid rgba(46,79,87,.6);
                    background:linear-gradient(180deg,rgba(255,253,247,.42),rgba(255,253,247,.86));
                    color:var(--ink);font-family:inherit;
                    font-size:15px;letter-spacing:2px;outline:none;box-sizing:border-box;
                    transition:border-color .15s,background .15s;}
  .saveNewRow input::placeholder{color:rgba(46,79,87,.40);font-size:14px;letter-spacing:1px;}
  .saveNewRow input:focus{border-bottom-color:#b03a2e;background:rgba(255,253,247,.95);}
  /* 存档列表滚动条 → 细笔杆 */
  .saveList::-webkit-scrollbar{width:9px;}
  .saveList::-webkit-scrollbar-track{background:transparent;}
  .saveList::-webkit-scrollbar-thumb{background:rgba(46,79,87,.30);border-radius:5px;
        border:2px solid transparent;background-clip:padding-box;}
  .saveList::-webkit-scrollbar-thumb:hover{background:rgba(46,79,87,.52);background-clip:padding-box;}
  #screen-saves .note{position:absolute;right:0;left:0;bottom:26px;text-align:center;
                      color:var(--ink);font-size:14px;letter-spacing:2px;}

  /* 纸页翻转：旧页面留在纸面上，翻开后显露下一页。 */
  #pageTurnLayer{position:absolute;inset:0;z-index:90;display:none;perspective:1800px;
    overflow:hidden;isolation:isolate;pointer-events:auto;}
  #pageTurnLayer.play{display:block;}
  .pageShade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,27,23,.26),transparent 65%);
    animation:pageShadeOut .82s ease-out both;pointer-events:none;}
  .pageSheet{position:absolute;inset:0;transform-origin:0 50%;transform-style:preserve-3d;
    animation:paperTurn .82s cubic-bezier(.38,.08,.22,1) both;will-change:transform;}
  .pageFace{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;
    background:#f7f3e8;overflow:hidden;}
  .pageFront::after{content:'';position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(90deg,rgba(73,58,37,.2),transparent 9%,transparent 74%,rgba(255,252,238,.3));
    animation:paperLight .82s ease both;}
  .pageBack{transform:rotateY(180deg);background:linear-gradient(90deg,#ddd5c1,#faf7ed 12%,#eee8d7 78%,#c8bea6);
    box-shadow:inset -24px 0 32px rgba(55,42,23,.18);}
  .pageBack::after{content:'';position:absolute;inset:0;opacity:.2;
    background:repeating-linear-gradient(3deg,transparent 0 3px,rgba(88,72,47,.1) 4px,transparent 5px 8px);}
  #pageTurnLayer.reverse .pageSheet{transform-origin:100% 50%;animation-name:paperTurnBack;}
  #pageTurnLayer.reverse .pageShade{background:linear-gradient(270deg,rgba(30,27,23,.26),transparent 65%);}
  @keyframes paperTurn{
    0%{transform:rotateY(0deg);}
    35%{transform:rotateY(-32deg);}
    72%{transform:rotateY(-128deg);}
    100%{transform:rotateY(-180deg);}
  }
  @keyframes paperTurnBack{
    0%{transform:rotateY(0deg);}
    35%{transform:rotateY(32deg);}
    72%{transform:rotateY(128deg);}
    100%{transform:rotateY(180deg);}
  }
  @keyframes paperLight{0%{opacity:0;}40%{opacity:1;}100%{opacity:.65;}}
  @keyframes pageShadeOut{0%{opacity:0;}28%{opacity:.8;}100%{opacity:0;}}
  /* 开始选关：宣纸上的中性墨色，层层渗化，不使用绿色圆形遮罩。 */
  #inkLayer{position:absolute;inset:0;z-index:100;display:none;overflow:hidden;pointer-events:auto;}
  #inkLayer.play{display:block;}
  #inkBloomCanvas{display:block;width:100%;height:100%;background:transparent;box-shadow:none;cursor:default;}
  #wrap.is-transitioning{cursor:wait;}

  /* 鹭岛 · 深海航站：首页视觉与交互。 */
  #screen-menu{--ice:#e6f7f4;--signal:#8ce5dc;--muted:#8ba7b6;--amber:#dcb681;
    display:none;background:#050e19;color:var(--ice);font-family:"Microsoft YaHei","PingFang SC",sans-serif;}
  #screen-menu.active{display:block;}
  #screen-menu::before{z-index:1;background:linear-gradient(90deg,rgba(4,12,22,.8),transparent 56%,rgba(4,12,22,.45)),
    radial-gradient(ellipse at 53% 38%,transparent 25%,rgba(2,8,15,.64) 100%);}
  #screen-menu::after{content:'';position:absolute;inset:22px;z-index:2;pointer-events:none;
    border:1px solid rgba(135,190,208,.12);clip-path:polygon(0 0,18% 0,18% 1%,82% 1%,82% 0,100% 0,100% 100%,82% 100%,82% 99%,18% 99%,18% 100%,0 100%);}
  #menuScene{position:absolute;inset:0;width:100%;height:100%;background:transparent;box-shadow:none;cursor:default;}
  .homeTop{position:absolute;left:64px;right:64px;top:44px;z-index:4;display:flex;justify-content:space-between;align-items:center;}
  .homeBrand{display:flex;align-items:center;gap:13px;font-size:13px;letter-spacing:4px;}
  .homeBrand svg{width:35px;height:30px;fill:none;stroke:var(--ice);stroke-width:1.5;}
  .homeBrand small{display:block;margin-top:7px;color:var(--muted);font:9px "Consolas",monospace;letter-spacing:3px;}
  .homeLocation{display:flex;gap:22px;align-items:center;color:var(--muted);font:11px "Consolas","Microsoft YaHei",monospace;letter-spacing:2px;}
  .homeLocation::before{content:'';width:6px;height:6px;background:var(--amber);box-shadow:0 0 15px #dcb68166;}
  .homeTitle{position:absolute;left:72px;top:160px;z-index:4;}
  .homeEyebrow{display:flex;gap:14px;align-items:center;color:var(--signal);font:10px "Consolas",monospace;letter-spacing:4px;}
  .homeEyebrow::before{content:'';width:30px;height:1px;background:var(--signal);}
  .homeTitle h1{margin:23px 0 18px;font-size:110px;line-height:1.04;font-weight:900;letter-spacing:12px;
    text-shadow:0 2px 0 #c5e7e455,0 10px 50px #3baccb13;}
  .homeTitle h1 span{display:block;}
  .homeTitle h1 span:last-child{color:transparent;-webkit-text-stroke:1.5px #d9eeec;
    text-shadow:2px 3px 0 rgba(93,198,205,.16);margin-left:48px;}
  .homeTitle h1 i{font-style:normal;display:inline-block;position:relative;}
  .homeTitle h1 i::after{content:'';position:absolute;right:-19px;bottom:9px;width:7px;height:7px;background:var(--amber);}
  .homeTitle p{margin:0;font-size:14px;letter-spacing:6px;color:#a5c3cc;}
  .titleRule{margin-top:25px;width:250px;display:flex;align-items:center;gap:14px;color:#8caab7;font:10px "Consolas",monospace;letter-spacing:2px;}
  .titleRule::after{content:'';height:1px;flex:1;background:linear-gradient(90deg,#72bfc87f,transparent);}
  .heroStage{position:absolute;left:431px;top:91px;width:480px;height:450px;z-index:3;pointer-events:none;}
  .heroHalo{position:absolute;width:334px;height:334px;left:77px;top:32px;border:1px solid #71c8d322;border-radius:50%;
    background:radial-gradient(circle,rgba(69,142,159,.12),rgba(17,56,76,.03) 60%,transparent 70%);}
  .heroHalo::before{content:'';position:absolute;inset:-14px;border:1px dashed #78ced322;border-radius:50%;}
  .heroHalo::after{content:'';position:absolute;inset:29px;border:1px solid #78ced312;border-radius:50%;}
  .heroFloat{position:absolute;left:52px;top:0;width:384px;height:414px;animation:heroHover 6s ease-in-out infinite;}
  #menuHero{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;
    transform:translate(var(--look-x,0px),var(--look-y,0px));transition:transform .6s ease-out;
    filter:saturate(.76) drop-shadow(0 0 24px rgba(71,196,226,.18));}
  .heroFootnote{position:absolute;left:154px;bottom:0;display:flex;gap:10px;align-items:center;
    font:9px "Consolas",monospace;letter-spacing:3px;color:#7bb4c3;}
  .heroFootnote::before{content:'';width:18px;height:1px;background:#80d4dd;}
  .heroCoordinate{position:absolute;right:21px;top:89px;font:8px "Consolas",monospace;letter-spacing:3px;
    color:#79a2b1;writing-mode:vertical-rl;}
  .navDock{position:absolute;right:76px;top:192px;width:286px;z-index:5;perspective:900px;}
  .dockHeading{display:flex;justify-content:space-between;color:var(--muted);font:10px "Consolas",monospace;letter-spacing:3px;margin-bottom:23px;}
  .dockHeading span:first-child{color:var(--amber);}
  .dockItem{animation:dockFloat 5s ease-in-out infinite;filter:drop-shadow(0 15px 16px rgba(0,0,0,.25));}
  .dockItem:hover,.dockItem:focus-within{animation-play-state:paused;}
  .dockItem:nth-of-type(3){margin:15px 0 0 15px;animation-delay:-2s;}
  .sciButton{--rx:0deg;--ry:0deg;--spot:30%;position:relative;display:flex;align-items:center;justify-content:space-between;
    width:100%;height:79px;padding:0 25px;border:0;cursor:pointer;color:var(--ice);text-align:left;
    font-family:inherit;letter-spacing:4px;background:linear-gradient(115deg,#183044ee,#0b1d2bee);
    clip-path:polygon(0 0,calc(100% - 15px) 0,100% 15px,100% 100%,15px 100%,0 calc(100% - 15px));
    transform:rotateX(var(--rx)) rotateY(var(--ry));transition:transform .25s ease,background .25s ease,filter .25s ease;}
  .sciButton::before{content:'';position:absolute;inset:0;border:1px solid #82ccda57;
    background:radial-gradient(circle at var(--spot) 50%,#85dce41a,transparent 65%);pointer-events:none;}
  .sciButton::after{content:'';position:absolute;top:0;bottom:0;left:-65%;width:48%;
    background:linear-gradient(105deg,transparent,#d8fff42a,transparent);transform:skewX(-22deg);pointer-events:none;}
  .sciButton:hover::after{animation:buttonSweep .7s ease-out;}
  .sciButton:hover{background:linear-gradient(115deg,#244b5f,#102b3c);filter:brightness(1.17);}
  .sciButton:focus-visible{outline:0;background:#28566a;box-shadow:inset 0 0 0 3px var(--ice);}
  .sciButton:active{transform:translateY(3px) scale(.985);}
  .sciButton strong{display:block;font-size:21px;font-weight:600;letter-spacing:5px;}
  .sciButton small{display:block;margin-top:7px;color:#8eafbd;font:9px "Consolas",monospace;letter-spacing:3px;}
  .sciButton .buttonArrow{font:25px "Consolas",monospace;font-weight:200;color:#94d8d9;transition:transform .25s ease;}
  .sciButton:hover .buttonArrow{transform:translateX(5px);}
  .sciButton.primary{height:90px;color:#092331;background:linear-gradient(115deg,#d7f8ef,#91cfd1);}
  .sciButton.primary::before{border-color:#dcfff1;}
  .sciButton.primary small{color:#35616b;}
  .sciButton.primary .buttonArrow{color:#164e5e;}
  .sciButton.primary:hover{background:linear-gradient(115deg,#edfff7,#a7e7e2);}
  .sciButton.primary:focus-visible{box-shadow:inset 0 0 0 3px #173f4e;}
  .dockAux{display:flex;gap:12px;margin:23px 0 0;}
  .dockAux button{position:relative;flex:1;height:36px;border:0;border-bottom:1px solid #7cc2cc40;color:#8eafbd;
    background:transparent;font:12px "Microsoft YaHei",sans-serif;letter-spacing:2px;cursor:pointer;transition:color .2s,border-color .2s;}
  .dockAux button:hover,.dockAux button:focus-visible{color:#e0fff7;border-color:#a4e6de;outline:0;}
  .dockAux span{font:10px "Consolas",monospace;margin-right:8px;color:#568698;}
  .dockNote{margin-top:25px;color:#8eabb8;font-size:11px;letter-spacing:3px;}
  #screen-menu .saveRowArt{left:72px;bottom:40px;gap:8px;padding:0 0 9px;background:transparent;border-radius:0;
    box-shadow:none;border-bottom:1px solid #77bdcc30;}
  #screen-menu .saveTag{writing-mode:horizontal-tb;color:var(--amber);font:10px "Consolas",monospace;letter-spacing:2px;margin-right:12px;opacity:1;}
  #screen-menu .saveRowArt #saveName{width:162px;height:30px;font-size:12px;color:#c8e5e7;letter-spacing:1px;
    border-bottom:1px solid #79b0bd45;background:transparent;}
  #screen-menu .saveRowArt #saveName::placeholder{color:#7696a7;font-size:11px;letter-spacing:1px;}
  #screen-menu .saveRowArt #saveName:focus{border-color:#8ae3dc;background:#143243;}
  #screen-menu .saveRowArt .abtn.tiny{color:#adc7cf;font-size:12px;letter-spacing:2px;height:30px;padding:0 8px;font-weight:400;}
  #screen-menu .saveRowArt .abtn.tiny:hover,#screen-menu .saveRowArt .abtn.tiny:focus-visible{background:#264d5f;color:#e6fff8;outline:1px solid #70bcca;}
  #screen-menu .note{right:72px;bottom:86px;max-width:400px;font-size:12px;letter-spacing:1px;color:#c8e6e4;
    background:#071621ed;padding:8px 14px;border-left:2px solid #dcb681;text-align:left;}
  .homeFooter{position:absolute;right:76px;bottom:44px;z-index:4;color:#8ba8b5;font:10px "Consolas",monospace;letter-spacing:2px;text-align:right;line-height:1.9;}
  #dbg{opacity:.35;}
  @keyframes heroHover{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
  @keyframes dockFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}
  @keyframes buttonSweep{from{left:-65%;}to{left:140%;}}
  @media(prefers-reduced-motion:reduce){
    #screen-menu *,#screen-menu *::before,#screen-menu *::after{animation:none!important;transition:none!important;}
    #menuHero,.sciButton{transform:none!important;}
  }

  /* 首页：成年立绘与光粒子的同一条入场轨迹。 */
  #screen-menu{--hero-alpha:1;--dock-alpha:1;}
  .heroStage{top:61px;left:425px;width:480px;height:500px;}
  .heroFloat{left:77px;top:-7px;width:310px;height:520px;animation:none;}
  #menuHero{image-rendering:auto;opacity:var(--hero-alpha);filter:drop-shadow(0 12px 22px #02121a66) drop-shadow(0 0 14px #79d8e31c);}
  .heroHalo{width:322px;height:414px;left:71px;top:3px;border-color:#81cbd324;border-radius:50%;
    background:radial-gradient(ellipse,rgba(131,211,214,.12),transparent 68%);}
  .heroHalo::before{inset:-11px;border-color:#82cbd015;}
  .heroHalo::after{inset:22px;border-color:#82cbd013;}
  .heroCoordinate{right:29px;top:112px;}
  .heroFootnote{left:153px;bottom:3px;}
  #arrivalParticles{position:absolute;inset:0;z-index:4;width:100%;height:100%;pointer-events:none;background:transparent;box-shadow:none;}
  .navDock{opacity:var(--dock-alpha);transition:opacity .18s linear;}
  .home-ready .heroFloat{animation:adultHover 7.6s ease-in-out infinite;}
  .home-arriving .heroFloat{will-change:transform;}
  .home-launching .sciButton.primary{background:linear-gradient(110deg,#f3fff9,#8be6e5);box-shadow:inset 0 0 0 2px #eafffb;}
  .home-launching .heroFloat{animation-play-state:paused;}
  #launchLayer{position:absolute;inset:0;z-index:110;display:none;pointer-events:auto;overflow:hidden;}
  #launchLayer.play{display:block;}
  #launchCanvas{width:100%;height:100%;display:block;background:transparent;box-shadow:none;cursor:wait;}
  @keyframes adultHover{0%,100%{transform:translateY(0) rotate(-.2deg);}50%{transform:translateY(-7px) rotate(.2deg);}}
  /* 选关：原画成为主角的海岸图册，界面与首页共用海蓝与淡金。 */
  #screen-select{display:none;isolation:isolate;overflow:hidden;background:#071a28;color:#e5f2ee;
    font-family:"Microsoft YaHei","PingFang SC",sans-serif;gap:0;}
  #screen-select.active{display:block;}
  #screen-select::before{content:'';position:absolute;inset:0;z-index:-2;pointer-events:none;
    background-image:var(--route-bg,none);background-size:cover;background-position:center;opacity:.37;}
  #screen-select::after{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;
    background:linear-gradient(100deg,#071a28e8,#092536b5 60%,#071a28e6),linear-gradient(0deg,#071a28,transparent 60%);}
  #screen-select .selHead{position:absolute;left:64px;top:62px;font-size:29px;letter-spacing:7px;text-indent:0;color:#e7f3ef;font-weight:500;}
  #screen-select .selHead::before{content:'COASTAL ATLAS / 12';display:block;margin-bottom:12px;color:#b5b18c;font:10px "Consolas",monospace;letter-spacing:3px;}
  #screen-select .selSub{position:absolute;right:64px;top:112px;margin:0;color:#9ab7c0;font-size:12px;letter-spacing:3px;text-indent:0;}
  #screen-select .lvGridWrap{position:absolute;left:64px;right:64px;top:175px;width:auto;padding:0;display:block;}
  #screen-select .lvGridWrap::after{display:none;}
  #screen-select .lvGrid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px 14px;align-items:stretch;}
  #screen-select .lvCard{width:100%;height:147px;box-sizing:border-box;margin:0!important;padding:0;display:block;min-width:0;
    border:1px solid #aacbd84d;border-radius:2px;box-shadow:0 7px 18px #020a1022;filter:none;background-color:#173345;
    background-position:center;cursor:pointer;font-family:inherit;animation:routeRise .5s ease both;animation-delay:calc(var(--route-order,0)*24ms);}
  #screen-select .lvCard::after{background:linear-gradient(0deg,#061826f5 0%,#091f3044 45%,transparent 75%);}
  #screen-select .lvCard:hover,#screen-select .lvCard:focus-visible{transform:translateY(-4px);border-color:#a4e8de;
    box-shadow:0 0 0 1px #91d8d333,0 12px 23px #020a1055;outline:0;}
  #screen-select .lvCard.locked{opacity:.57;cursor:not-allowed;border-color:#8babba38;box-shadow:none;}
  #screen-select .lvCard.locked:hover{transform:none;border-color:#8babba38;}
  #screen-select .lvCard.locked::after{background:linear-gradient(0deg,#081a2bf2,#10263555);}
  #screen-select .lvCard.now{border-color:#a6e9df;box-shadow:0 0 0 1px #9de1d940,0 7px 18px #020a1044;}
  #screen-select .lvCard.now::before{content:'当前';left:auto;right:8px;top:8px;width:auto;height:auto;line-height:1;
    padding:5px 7px;border-radius:0;box-shadow:none;transform:none;background:#d8f2e9;color:#123d48;font-size:10px;letter-spacing:2px;}
  #screen-select .lvNo{left:11px;top:10px;padding:0;background:transparent;color:#fff9ec;font:11px "Consolas",monospace;letter-spacing:2px;text-shadow:0 1px 7px #02131b;}
  #screen-select .lvCard.locked .lvNo{background:transparent;color:#c1ccd0;}
  #screen-select .lvName{left:13px;top:auto;bottom:29px;transform:none;writing-mode:horizontal-tb;color:#eef4eb;
    text-shadow:none;font-size:17px;font-weight:500;letter-spacing:3px;}
  #screen-select .lvState{left:13px;right:auto;bottom:10px;color:#b5d0d3;text-shadow:none;font-size:10px;letter-spacing:2px;}
  #screen-select .lvState::after{content:'↗';margin-left:9px;color:#a9e0d6;font-size:12px;}
  #screen-select .locked .lvState::after{content:'—';color:#8ea6b3;}
  .routeFooter{position:absolute;left:64px;right:64px;bottom:46px;display:flex;justify-content:space-between;align-items:center;
    padding-top:18px;border-top:1px solid #99c7cf30;}
  #routeCaption{font-size:12px;color:#a8c0c9;letter-spacing:2px;}
  #routeCaption strong{color:#e6f4ee;font-weight:500;}
  #screen-select #btnSelBack{min-width:180px;padding:11px 22px;font-size:12px;letter-spacing:3px;border:1px solid #94c3ca66;
    color:#dceeea;background:#102c3c99;box-shadow:none;border-radius:1px;}
  #screen-select #btnSelBack:hover{background:#224a5b;transform:translateX(-3px);}
  @keyframes routeRise{from{opacity:0;transform:translateY(12px);}to{transform:none;}}
  /* 战斗HUD：轻薄笺纸和海蓝标记，保留原先朱砂特色。 */
  #hud{font-family:"Microsoft YaHei","PingFang SC",sans-serif;}
  #stats{left:24px;top:20px;padding:12px 17px;background:linear-gradient(115deg,#edf2e9eb,#edf1e4d4);
    border:1px solid #5479846b;border-radius:3px;box-shadow:0 5px 16px #173d4c14;}
  #stats::before{width:21px;height:21px;font-size:12px;line-height:21px;left:-8px;top:-8px;background:#a64d3e;}
  #statName{font-size:12px;letter-spacing:3px;color:#254e59;margin-bottom:9px;}
  .bar{width:230px;height:10px;border:1px solid #557c8066;background:#244f5f17;border-radius:2px;margin-bottom:7px;}
  .barNum{font:8px "Consolas",monospace;line-height:10px;left:7px;letter-spacing:1px;}
  #hpFill{background:linear-gradient(90deg,#a44d3f,#c77c61);box-shadow:none;}
  #mpFill{background:linear-gradient(90deg,#386c7a,#7caaa6);box-shadow:none;}
  #aspeed{font-size:10px;letter-spacing:1px;color:#55767b;}
  #kills{top:25px;font:24px "Consolas",monospace;letter-spacing:1px;color:#295664;text-shadow:0 1px 0 #eaf5e4a8;}
  #kills::after{font-family:"Microsoft YaHei",sans-serif;font-size:9px;letter-spacing:5px;margin-top:7px;}
  #lvlBuffs{top:87px;}
  #waveTitle{font-family:"Microsoft YaHei",sans-serif;font-size:27px;letter-spacing:10px;color:#274f5d;
    background:#f2f1e6d9;padding:12px 26px;border-top:1px solid #48798455;border-bottom:1px solid #48798455;}
  #btnPause{top:22px;border-radius:2px;border-color:#74999f88;background:#eef3e7e6;color:#244e5a;font-family:inherit;font-size:11px;padding:8px 16px;}
  #tip{color:#dcebe5;background:#173b4bcc;padding:7px 12px;border-radius:2px;font-size:10px;letter-spacing:1px;}
  #vignette{background:radial-gradient(ellipse at center,transparent 55%,rgba(23,57,70,.08));}
  /* 暂停、结算、存档与强化延续同一海岸航站语言。 */
  #overlay,#screen-saves{background:linear-gradient(120deg,#071a29f5,#173847f5);color:#e5f2ec;font-family:"Microsoft YaHei",sans-serif;}
  #screen-saves{background:linear-gradient(120deg,#071a29,#173847);}
  #ovTag{color:#d5b68e;font-size:11px;letter-spacing:7px;}
  #ovTitle,#screen-saves .selHead{color:#e3f2ec;font-weight:500;font-size:29px;letter-spacing:5px;}
  #ovSub{color:#91b4be;font-size:12px;letter-spacing:2px;}
  #overlay .btn,#screen-saves .btn,#screen-saves .abtn{background:linear-gradient(115deg,#244759,#112b3c);color:#dfefeb;border:1px solid #83bdc06b;box-shadow:none;border-radius:2px;}
  #overlay .btn.primary{background:linear-gradient(115deg,#d2f0e6,#91c9cb);color:#123846;border-color:#c7f0e7;}
  #overlay .btn:hover,#screen-saves .btn:hover,#screen-saves .abtn:hover{filter:brightness(1.15);}
  .auLabel{color:#a2c0c5;}
  .saveCard{background:linear-gradient(120deg,#244653,#153443);border-color:#75acb44d;color:#e0efeb;box-shadow:none;}
  .scMeta,.scTime,.scNone,.saveEmpty{color:#94b4bf;}
  .scBuffs .buffChip{color:#bde0de;border-color:#76adb159;background:#83bcc00d;}
  .saveNewRow input{background:#10303e;color:#d9ebe7;border-color:#82c8c4;font-family:inherit;}
  .saveNewRow input::placeholder{color:#85a6b2;}
  .saveNewRow input:focus{background:#254857;}
  #screen-saves .note{color:#b9dfdb;}
  #cardLayer{background:#e5eddfeb;font-family:"Microsoft YaHei",sans-serif;}
  #cardLayer::before{filter:none;opacity:.15;}
  #cardHead{font-size:31px;letter-spacing:12px;color:#244e5b;font-weight:500;}
  #cardSub{font-size:12px;color:#6b898c;letter-spacing:3px;}
  .upCard{border-radius:5px;box-shadow:0 12px 30px #254c5b14;border-width:1px;}
  .upCard::after{border-radius:2px;opacity:.35;}
  .cCorner{opacity:.32;}
  #dbg{opacity:.22;}
  @media(prefers-reduced-motion:reduce){
    #screen-select .lvCard{animation:none!important;transition:none!important;}
    .home-ready .heroFloat{animation:none!important;}
    #menuHero,.navDock{transition:none!important;}
  }

  /* 原立绘分层显示：人物与剑仍来自同一张图片。 */
  #homeClipDefs{position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;}
  #screen-menu.sword-layer-ready #menuHero{clip-path:url(#homeBodyClip);}
  #screen-menu.sword-layer-ready #menuHero{transform:translate(var(--look-x,0px),var(--look-y,0px)) rotate(var(--idle-roll,0deg)) scale(var(--idle-scale-x,1),var(--idle-scale-y,1));transform-origin:50% 70%;}
  #homeSword{position:absolute;inset:0;display:none;width:100%;height:100%;pointer-events:none;
    background:transparent;box-shadow:none;opacity:var(--hero-alpha);transform-origin:81% 18%;
    filter:drop-shadow(0 4px 6px #04172366) drop-shadow(0 0 6px #9be9ea44);will-change:transform;}
  #screen-menu.sword-layer-ready #homeSword{display:block;}
  #swordAura{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3;background:transparent;box-shadow:none;opacity:var(--hero-alpha);}
  #screen-menu.sword-layer-ready .heroFootnote{letter-spacing:2px;}
  @media(prefers-reduced-motion:reduce){#homeSword{transform:none!important;will-change:auto;}#swordAura{display:none;}}
/* 地图夜航：只对场景底图做预合成，角色和敌人不会跟着整屏变暗。 */
.nightMapToggle{--switch-ink:#b9d4d8;display:inline-flex;align-items:center;justify-content:center;gap:10px;
  min-height:34px;box-sizing:border-box;padding:8px 12px;border:1px solid #81bac15c;border-radius:3px;
  background:#102d3bcc;color:var(--switch-ink);font:11px "Microsoft YaHei","PingFang SC",sans-serif;
  letter-spacing:1px;cursor:pointer;box-shadow:inset 0 1px 0 #c7ebe90a;white-space:nowrap;
  transition:background .18s,border-color .18s,color .18s;}
.nightMapToggle:hover{background:#234655;border-color:#9ce0da;color:#f0fff9;}
.nightMapToggle:focus-visible{outline:2px solid #b9f4e9;outline-offset:4px;}
.nightMapToggle[aria-pressed="true"]{background:#164757;border-color:#81d6d5;color:#d7fff5;}
.nightSwitchTrack{position:relative;display:block;width:25px;height:14px;flex:0 0 25px;
  border:1px solid #91b8bf88;border-radius:9px;background:#081e2d;box-sizing:border-box;}
.nightSwitchTrack::after{content:'';position:absolute;left:3px;top:3px;width:6px;height:6px;
  border-radius:50%;background:#a5bdc3;transition:transform .18s,background .18s;}
[aria-pressed="true"] .nightSwitchTrack{border-color:#8bd9d1;background:#214d59;}
[aria-pressed="true"] .nightSwitchTrack::after{transform:translateX(11px);background:#c5fff0;box-shadow:0 0 7px #7ee6df88;}
.homeLocation{gap:16px;}
#btnNightHome{margin-left:4px;letter-spacing:1px;}
#btnNightHud{position:absolute;right:112px;top:22px;pointer-events:auto;min-height:32px;padding:7px 11px;
  background:#edf3e8eb;border-color:#74999f88;color:#244e5a;}
#btnNightHud .nightSwitchTrack{background:#e0eade;border-color:#728e9388;}
#btnNightHud .nightSwitchTrack::after{background:#5d7a7e;}
#btnNightHud:hover{background:#dcece5;border-color:#3c7a85;}
#nightPauseRow{display:none;align-items:center;justify-content:center;margin-top:2px;gap:12px;}
#audioRow.show + #nightPauseRow{display:flex;}
.nightModeHint{font:10px "Microsoft YaHei",sans-serif;color:#8baab5;letter-spacing:1px;}
.nightModeAnnouncement{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;
  margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;}
html.map-night,html.map-night body{background:#071522;}
.map-night #stats{background:linear-gradient(115deg,#102d3ef0,#143747e8);border-color:#82b7c45e;
  box-shadow:0 5px 18px #020b1466;}
.map-night #statName{color:#d7eae8;}
.map-night #aspeed{color:#9ebfc3;}
.map-night .bar{background:#071c2988;border-color:#86b1b766;}
.map-night #hpFill{background:linear-gradient(90deg,#a94e47,#d48c74);}
.map-night #mpFill{background:linear-gradient(90deg,#3c788f,#8acbd0);}
.map-night #kills{color:#e1f3e9;text-shadow:0 2px 9px #02121e;}
.map-night #kills::after{color:#b9d5d8;}
.map-night #lvlBuffs .buffChip{background:#103447e0;color:#d7f0e7;border-color:#82b7bc66;}
.map-night #waveTitle{color:#e0f4ee;background:#0d2c3ee8;border-color:#8dc6c75e;text-shadow:none;}
.map-night #btnPause,.map-night #btnNightHud{background:#102e40ef;color:#d5efea;border-color:#91bac06b;}
.map-night #btnPause:hover,.map-night #btnNightHud:hover{background:#295267;color:#f1fffb;}
.map-night #btnNightHud[aria-pressed="true"]{background:#184959;color:#d9fff4;border-color:#83d4d1;}
.map-night #btnNightHud .nightSwitchTrack{background:#0c2634;border-color:#88c1c58c;}
.map-night #btnNightHud .nightSwitchTrack::after{background:#c1f9eb;}
.map-night #tip{background:#061b2ce8;color:#c3dde0;border:1px solid #7fadb333;}
.map-night #vignette{background:radial-gradient(ellipse at center,transparent 58%,rgba(3,15,30,.16));}
.map-night #screen-select::before{opacity:.43;filter:brightness(.68) saturate(.72);}
.map-night #screen-select::after{background:linear-gradient(100deg,#061421ef,#0d2b3bac 60%,#061421e8),linear-gradient(0deg,#061421,transparent 62%);}
.map-night #screen-select .lvCard::after{background:linear-gradient(0deg,#061624f5 0%,#0d365c55 50%,#07243c66 100%);}
.map-night #screen-select .lvCard.locked::after{background:linear-gradient(0deg,#061624f5,#102c4e99);}
.map-night #cardLayer{background:#081d2cee;}
.map-night #cardLayer::before{opacity:.18;filter:brightness(.45) saturate(.65);}
.map-night #cardHead{color:#dceee8;}
.map-night #cardSub{color:#a4c3c6;}
.map-night .upCard{background:linear-gradient(150deg,#1b3b50,#102a3d 55%,#1a3549);
  border-color:var(--c-soft);box-shadow:0 12px 30px #020b155c;}
.map-night .upCard.rare-普通{--c-deep:#aed4ef;--c-soft:#76a6c3;--c-pill:#28506b;}
.map-night .upCard.rare-稀有{--c-deep:#d1bdf0;--c-soft:#a290cb;--c-pill:#403b62;}
.map-night .upCard.rare-史诗{--c-deep:#edb1a1;--c-soft:#c98a7e;--c-pill:#623d44;}
.map-night .cDesc{color:#cce1dd;}
.map-night #cardSkip{background:#1c3d4f;color:#cfe4df;box-shadow:inset 0 0 0 1px #8bbac366;}
.map-night #cardSkip:hover{background:#2c5363;color:#f2fffa;}
.map-night #dbg{color:#d4ebe1;opacity:.28;}
@media(prefers-reduced-motion:reduce){.nightMapToggle,.nightSwitchTrack::after{transition:none;}}

/* Native pixel clusters remain sharp in the chapter thumbnails. */
#screen-select .lvCard{image-rendering:pixelated;}
/* Keep the stage name and wave count readable over every ground palette. */
#kills{top:18px;padding:8px 12px 7px;min-width:80px;background:rgba(250,247,238,.94);border:1px solid rgba(46,79,87,.45);border-radius:4px;box-shadow:0 2px 8px rgba(10,35,44,.12);}
#kills::before{content:attr(data-level);display:block;font:600 10px "Microsoft YaHei",sans-serif;letter-spacing:1px;margin-bottom:4px;color:#2e4f57;}
#kills::after{margin-top:3px;color:#42636c;}
.map-night #kills{background:rgba(8,29,43,.94);border-color:rgba(141,197,210,.42);}
.map-night #kills::before{color:#c3e0e4;}
</style>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>/* Gesture controls extend the original stage; game artwork and layout stay intact. */
#gestureLaunch{position:absolute;right:22px;top:65px;z-index:18;border:1px solid #74999f88;border-radius:2px;background:#102e40ed;color:#d5efea;padding:8px 15px;font:11px "Microsoft YaHei",sans-serif;cursor:pointer;letter-spacing:1px}
#gestureLaunch[hidden]{display:none}
#gesturePanel{position:absolute;inset:0;z-index:120;background:#030c17b8;display:flex;align-items:center;justify-content:center;font-family:"Microsoft YaHei",sans-serif;color:#dfefec}
#gesturePanel[hidden]{display:none}
.gestureSheet{width:860px;max-height:600px;box-sizing:border-box;padding:28px 32px;background:linear-gradient(120deg,#102a3b,#071722);border:1px solid #6ba7b561;box-shadow:0 20px 80px #0008;position:relative}
.gestureSheet h2{margin:0 0 8px;font-size:27px;font-weight:500;letter-spacing:5px}.gestureEyebrow{font:10px Consolas,monospace;letter-spacing:3px;color:#96d6ce;margin-bottom:12px}
.gestureIntro{color:#a9c4cd;font-size:12px;line-height:1.8;margin:0 0 23px}.gestureGrid{display:grid;grid-template-columns:1fr 320px;gap:26px}
.gestureRules{margin:0;padding:0;list-style:none}.gestureRules li{display:grid;grid-template-columns:42px 1fr;gap:10px;padding:11px 0;border-bottom:1px solid #83bac31f;font-size:13px;line-height:1.75}.gestureRules b{font-weight:500;color:#dcb681}.gestureRules small{display:block;color:#93aeb9;font-size:11px}
.gestureKey{width:32px;height:32px;border:1px solid #9ac7cc44;display:grid;place-items:center;font-size:11px;color:#9fdfd7}
#gesturePreview{height:240px;width:320px;position:relative;background:#04111c;overflow:hidden;border:1px solid #77afbe44;box-sizing:border-box}
#gestureVideo{width:100%;height:100%;object-fit:fill;transform:scaleX(-1);display:block;opacity:.67}
#gestureSkeleton,#gestureThree{position:absolute;inset:0;width:100%;height:100%;background:transparent;box-shadow:none;pointer-events:none;cursor:default}
#gesturePreviewNote{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:12px;line-height:2;color:#a2bdc6;pointer-events:none;background:radial-gradient(ellipse,#17374988,transparent)}
#gesturePreviewNote[hidden]{display:none}
.gestureTrack{display:flex;justify-content:space-between;margin-top:9px;font-size:10px;color:#9cb4bd;letter-spacing:1px}.gestureTrack .found{color:#9de5cf}
#gestureStatus{font-size:12px;line-height:1.7;min-height:40px;margin:13px 0 0;color:#bbd6d8}
.gestureActions{display:flex;gap:10px;margin-top:20px;align-items:center}.gestureBtn{border:1px solid #7bbcb469;background:#1e4a51;color:#e5fff8;padding:11px 20px;font:12px "Microsoft YaHei",sans-serif;cursor:pointer;letter-spacing:1px}.gestureBtn:hover{background:#2b6365}.gestureBtn.secondary{background:transparent;color:#a4c0c7}.gestureBtn:disabled{opacity:.45;cursor:wait}.gestureClose{position:absolute;right:24px;top:23px;background:transparent;border:0;color:#c5dcdd;font-size:24px;cursor:pointer;width:32px;height:32px}
.gestureSetting{font-size:11px;color:#91adb8;display:flex;align-items:center;gap:12px;margin-top:17px}.gestureSetting select{background:#112f40;color:#cee2e1;border:1px solid #6d9cae66;padding:4px 8px;font:inherit}
.gesturePrivacy{font-size:10px;line-height:1.8;color:#88a3ad;margin-top:16px;margin-bottom:0}.gesturePrivacy a{color:#a9cfcb}
#gestureBadge{position:absolute;bottom:38px;right:22px;z-index:19;color:#c8e5df;background:#0c2638e8;border-left:2px solid #98d8cd;padding:8px 12px;max-width:340px;font:11px "Microsoft YaHei",sans-serif;letter-spacing:.5px;pointer-events:none}
#gestureBadge[hidden]{display:none}
#gestureCursor{position:absolute;z-index:130;width:24px;height:24px;border:2px solid #a3f7df;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none;box-sizing:border-box;box-shadow:0 0 12px #84ffdc55;background:conic-gradient(#dcb681 var(--dwell,0%),transparent 0)}
#gestureCursor[hidden]{display:none}.gestureHover{outline:2px solid #9be3d3!important;outline-offset:3px}
#gestureMovePad{position:absolute;left:22px;bottom:22px;z-index:19;pointer-events:none;text-align:center;color:#d2e9e2;background:#102b3bdc;border:1px solid #8bcebd55;padding:10px 12px 8px;font:10px "Microsoft YaHei",sans-serif;border-radius:4px}
#gestureMovePad[hidden]{display:none}.gestureMoveRing{width:76px;height:76px;margin:0 auto 7px;border:1px solid #9ecfbe66;border-radius:50%;position:relative;background:radial-gradient(circle,#9ed9bf22 0 17%,transparent 18%)}
#gestureMoveDot{position:absolute;left:29px;top:29px;width:18px;height:18px;border-radius:50%;background:#a5e3ce;box-shadow:0 0 10px #a5e3ce44}#gestureMovePad small{display:block;font-size:9px;line-height:1.8;letter-spacing:.5px}
.gestureBtn:focus-visible,.gestureClose:focus-visible,#gestureLaunch:focus-visible{outline:2px solid #dcb681;outline-offset:3px}
@media(prefers-reduced-motion:reduce){#gesturePanel *{transition:none!important}}
</style>
<style>#gamepadLaunch{position:absolute;right:22px;top:106px;z-index:19;border:1px solid #74999f88;border-radius:2px;background:#102e40ed;color:#d5efea;padding:8px 15px;font:11px "Microsoft YaHei",sans-serif;cursor:pointer;letter-spacing:1px}
#gamepadPanel{position:absolute;inset:0;z-index:122;background:#030c17b8;display:flex;align-items:center;justify-content:center;font-family:"Microsoft YaHei",sans-serif;color:#dfefec}
#gamepadPanel[hidden],#gamepadBadge[hidden]{display:none}
.gamepadSheet{position:relative;box-sizing:border-box;width:790px;max-height:610px;overflow:auto;padding:28px 32px;background:linear-gradient(120deg,#102a3b,#071722);border:1px solid #6ba7b561;box-shadow:0 20px 80px #0008}
.gamepadSheet h2{margin:0 0 8px;font-size:27px;font-weight:500;letter-spacing:5px}.gamepadIntro{font-size:12px;color:#a9c4cd;line-height:1.8;margin:0 0 20px}
.gamepadDeviceLabel{display:flex;align-items:center;gap:14px;font-size:12px;color:#a9c4cd}.gamepadDeviceLabel select{min-width:0;flex:1;padding:8px;background:#112f40;color:#cee2e1;border:1px solid #6d9cae66;font:12px "Microsoft YaHei",sans-serif}
.gamepadKeys{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin:23px 0 20px}.gamepadKeys>div{padding:16px 8px;text-align:center;background:#ffffff04;border:1px solid #83bac326}.gamepadKeys span{display:grid;place-items:center;width:42px;height:42px;border:1px solid #9ac7cc66;border-radius:50%;margin:0 auto 12px;font:20px Consolas,monospace;color:#bce6dc}.gamepadKeys span.pressed{background:#9de5cf;color:#102a3b;box-shadow:0 0 15px #9de5cf44}.gamepadKeys b{font-size:12px;font-weight:500;color:#dcb681}
.gamepadHelp{font-size:12px;line-height:1.9;color:#a9c4cd;margin:0 0 14px}#gamepadStatus{font-size:12px;line-height:1.8;min-height:22px;color:#c8e5df;margin:0 0 7px}#gamepadMapping{font:11px "Microsoft YaHei",sans-serif;color:#88a3ad;margin:0 0 18px}.gamepadActions{display:flex;flex-wrap:wrap;gap:8px}.gamepadActions .gestureBtn{padding:10px 13px}.gamepadFootnote{font-size:10px;line-height:1.9;color:#88a3ad;margin:18px 0 0}
#gamepadBadge{position:absolute;right:22px;bottom:76px;z-index:19;max-width:350px;padding:8px 12px;background:#0c2638e8;border-left:2px solid #dcb681;color:#d8eae3;font:11px "Microsoft YaHei",sans-serif;pointer-events:none}
#gamepadLaunch:focus-visible{outline:2px solid #dcb681;outline-offset:3px}
.gamepadFocused{outline:3px solid #a5e3ce!important;outline-offset:4px!important;box-shadow:0 0 18px #a5e3ce38!important}
.gamepadKeys{gap:8px;margin:15px 0}.gamepadKeys>div{padding:8px}.gamepadKeys span{width:30px;height:30px;margin-bottom:7px;font-size:17px}
.gamepadStickRow{display:flex;align-items:center;gap:14px;margin:10px 0 15px}.gamepadStick{position:relative;width:46px;height:46px;flex:none;border:1px solid #9ac7cc66;border-radius:50%;background:radial-gradient(circle,#9de5cf14 0 18%,transparent 20%)}#gamepadStickDot{position:absolute;top:17px;left:17px;width:12px;height:12px;border-radius:50%;background:#9de5cf}.gamepadStickRow small{font-size:10px;line-height:1.8;color:#93aeb9}
</style>
<style>/* Supplied 1748 x 900 composition, scaled together with every hit target. */
@font-face{font-family:EgretBrush;src:url('assets/ui-v6/brush.ttf') format('truetype');font-display:swap}
html,body{background:#11100f!important}
#wrap.ink-edition{height:659.039px;background:#f5f2ea;color:#171513;font-family:EgretBrush,KaiTi,STKaiti,"楷体",serif}
.ink-edition .ink-page,.ink-edition #overlay,.ink-edition #cardLayer{font-family:EgretBrush,KaiTi,STKaiti,serif!important}
.ink-edition #game{width:1280px;height:659.039px;box-shadow:none}
.ink-edition button,.ink-edition input,.ink-edition output{font-family:inherit}
.ink-edition button{cursor:pointer;touch-action:manipulation}
.ink-edition button:disabled{cursor:default}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
#legacyHome,#gamepadLaunch,#gestureLaunch,#btnNightHome{display:none!important}
.ink-edition #hud:not(.show),.ink-edition #dbg{display:none!important}
#cinema{position:absolute;inset:0;z-index:5;background:#000;pointer-events:none;transition:opacity .35s ease}
.video-fallback #cinema{background:#f5f3ef url('assets/ui-v6/reference-1.png') center/100% 100%}
#cinema.cinema-hidden{opacity:0;visibility:hidden}
#cinema video{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;box-shadow:none;background:transparent}
#homeIntro{opacity:1;transition:opacity .38s ease}
.idle-running #homeIntro,.video-fallback #homeIntro{opacity:0}
#homeIdle{opacity:0;transition:opacity .35s ease}
.idle-running #homeIdle{opacity:1}
.ink-edition #screen-menu{position:absolute;inset:0;display:none;background:none!important;color:#681c16;z-index:11;animation:none!important;overflow:hidden;pointer-events:none}
.ink-edition #screen-menu.active{display:block}
.ink-edition #screen-menu::before,.ink-edition #screen-menu::after{display:none!important}
#homeActions{position:absolute;inset:0;pointer-events:none}
.ink-edition .homeHotspot{position:absolute;margin:0;padding:0;border:0;box-shadow:none;clip-path:none;background:transparent;color:transparent;transform:none!important;pointer-events:auto;outline:0;transition:box-shadow .25s ease,background-color .25s ease}
.ink-edition .homeHotspot::before,.ink-edition .homeHotspot::after{content:'';position:absolute;inset:9% -8%;background:none;border:0;transform:none;box-shadow:none;opacity:0;transition:opacity .25s}
.ink-edition .homeHotspot::after{inset:auto 5% 0;height:2px;background:#791f17;filter:blur(.5px)}
.ink-edition .homeHotspot:hover::before,.ink-edition .homeHotspot:focus-visible::before,.ink-edition .homeHotspot.gamepadFocused::before{opacity:1;background:radial-gradient(ellipse,#681c161b,transparent 70%)}
.ink-edition .homeHotspot:hover::after,.ink-edition .homeHotspot:focus-visible::after,.ink-edition .homeHotspot.gamepadFocused::after{opacity:.8}
.ink-edition #btnStart{left:75.7%;top:56.4%;width:12.6%;height:7.1%}
.ink-edition #btnSettings{left:78.7%;top:65%;width:7.2%;height:6.8%}
.ink-edition .homeHotspot:disabled{pointer-events:none}
#cinemaStatus{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);font-size:16px;padding:8px 18px;background:#faf7efdc;color:#612018;pointer-events:none}
.ink-edition .ink-page{position:absolute;inset:0;z-index:13;display:none;padding:0!important;background:#f4f1e9 url('assets/ui-v6/navigation.png') center/100% 100%!important;overflow:hidden;animation:none!important;color:#161413;isolation:isolate}
.ink-edition .ink-page.active{display:block}
.ink-edition .ink-page::before,.ink-edition .ink-page::after{display:none!important}
.ink-back{position:absolute;left:44.4%;top:7.9%;font-size:27px;font-weight:bold;letter-spacing:3px;color:#171513;border:0;background:none;padding:4px 0;z-index:2}
.ink-back:hover,.ink-back:focus-visible{color:#701b15}
.ink-heading{position:absolute;left:56.7%;top:4.2%;width:28%;height:15.8%;margin:0;background-repeat:no-repeat;background-size:1280px 659.039px;mix-blend-mode:multiply;pointer-events:none}
.ref-2{background-image:url('assets/ui-v6/reference-2.png');background-position:-726px -28px}
.ref-3{background-image:url('assets/ui-v6/reference-3.png');background-position:-726px -28px}
.ref-4{background-image:url('assets/ui-v6/reference-4.png');background-position:-726px -28px}
.ink-rule{height:1px;background:linear-gradient(90deg,transparent,#28241eb0 8%,#28241eb0 92%,transparent);position:absolute;text-align:center}
.ink-rule span{position:absolute;left:50%;top:-7px;transform:translateX(-50%);padding:0 7px;font-size:13px;background:#f5f2ec}
.heading-rule{left:46.6%;right:5.3%;top:21.4%}
.ink-content{position:absolute;left:47.8%;right:7.6%;top:25%;bottom:5%}
.ink-carousel{position:absolute;left:0;right:0;top:5.3%;height:80%;display:grid;grid-template-rows:repeat(3,1fr)}
.carousel-item,.carousel-empty{position:relative;min-height:0;box-sizing:border-box;border:0;background:none;width:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#191715;outline-offset:-5px}
.carousel-item{border-bottom:1px solid #2d27254a;border-radius:0;transition:color .2s,background .2s}
.carousel-item:last-child{border:0}
.carousel-item strong{position:relative;font-size:39px;font-weight:bold;letter-spacing:6px;line-height:1.4;max-width:93%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:.42;filter:blur(.5px);transform:scale(.85);transition:opacity .24s,filter .24s,transform .24s}
.carousel-item small{position:relative;display:block;margin-top:4px;font-size:18px;letter-spacing:2px;opacity:.45}
.carousel-item.selected strong{font-size:53px;opacity:1;filter:none;transform:none}
.carousel-item.selected small{opacity:1}
.carousel-item.selected::before{content:'';position:absolute;inset:5% -6%;background:radial-gradient(ellipse,#7a71611b,transparent 72%);pointer-events:none;transform:rotate(-3deg)}
.selection-seal{display:none;position:absolute;left:10%;top:40%;width:27px;height:27px;border:3px solid #6c2119;border-radius:49% 45% 51% 44%;box-shadow:0 0 0 1px #8b53403a;transform:rotate(-12deg)}
.selection-seal::after{content:'';position:absolute;inset:6px;background:#751d16;border-radius:50%}
.selected .selection-seal{display:block}
.carousel-item.selected:hover strong{color:#6b1e17}
.ink-chevron{position:absolute;left:44%;width:56px;height:36px;background:none;border:0;font-size:43px;line-height:25px;font-weight:bold;color:#393831b0;z-index:2;padding:0}
.ink-chevron.prev{top:-.5%}.ink-chevron.next{bottom:6%}
.ink-chevron:disabled{opacity:.18}
.ink-message{position:absolute;bottom:0;left:0;right:0;text-align:center;font-size:16px;color:#6a261e;margin:0}
#screen-select .ink-content{bottom:3%}
#screen-select .ink-carousel{height:74%;top:3%}
#screen-select .ink-chevron.next{bottom:15%}
.ink-enter{position:absolute;left:7%;right:0;bottom:0;width:86%;height:66px;background:radial-gradient(ellipse,#6b5e4b15,transparent 72%);border:0;color:#751c16;font-size:39px;font-weight:bold;letter-spacing:6px;transition:transform .2s,color .2s}
.ink-enter:hover{transform:translateX(5px)}
.ink-enter:disabled{color:#928c80;font-size:28px}
#levelCarousel .selected::before{background-image:linear-gradient(90deg,#f6f3ec99,#f6f3eccc),var(--landscape);background-size:cover;background-position:center;opacity:.18;filter:grayscale(1);transform:none;mask-image:radial-gradient(ellipse,#000,transparent 73%)}
.ink-settings{position:absolute;left:48.6%;right:9.5%;top:24%;bottom:6%;display:flex;flex-direction:column}
.setting-row{position:relative;display:flex;align-items:center;justify-content:space-between;flex:1;border-bottom:1px solid #79726732;font-size:30px;letter-spacing:2px;font-weight:bold;gap:15px}
.setting-row button{background:none;border:0;color:inherit;font:inherit;letter-spacing:inherit;padding:4px 0}
.setting-row.exit-row{border-bottom:0;color:#731b15}
.setting-row .ink-small{font-size:18px;color:#51443a;font-weight:normal;letter-spacing:1px;border-bottom:1px solid #a5978a}
.setting-row .ink-toggle{position:relative;width:92px;height:39px;background:#3e3b37!important;clip-path:polygon(5% 4%,95% 0,100% 22%,96% 49%,100% 75%,92% 97%,7% 100%,0 71%,3% 43%,0 20%);border:0;transition:background .22s;flex-shrink:0}
.setting-row .ink-toggle::before{content:'';position:absolute;top:4px;left:6px;width:31px;height:31px;border-radius:50%;background:#eeeae3;box-shadow:0 0 0 1px #14120f;transition:transform .22s cubic-bezier(.2,.7,.3,1)}
.setting-row .ink-toggle[aria-checked="true"]{background:#721f1a!important}
.setting-row .ink-toggle[aria-checked="true"]::before{transform:translateX(48px);box-shadow:inset 0 0 0 6px #f6f3eb;background:#7c201a}
.setting-row output{font-size:26px;min-width:57px;letter-spacing:0}
.setting-row input[type="range"]{width:280px;margin-left:auto}
.setting-row .ink-download{font-size:45px;width:92px;line-height:1}
.ink-edition input[type="range"]{appearance:none;height:6px;background:#5c5550a0;border-radius:20% 35%;accent-color:#76221c;cursor:pointer;padding:0;min-width:0}
.ink-edition input[type="range"]::-webkit-slider-thumb{appearance:none;width:25px;height:25px;background:#77231f;border:2px solid #f7f0e6;border-radius:50%;box-shadow:0 0 0 1px #5d2723}
.ink-edition input[type="range"]::-moz-range-thumb{width:22px;height:22px;background:#77231f;border:2px solid #f7f0e6;border-radius:50%}
.ink-edition button:focus-visible,.ink-edition input:focus-visible{outline:2px solid #7c2821;outline-offset:4px}
.ink-edition .gamepadFocused:not(.homeHotspot),.ink-edition .gestureHover:not(.homeHotspot){outline:2px solid #7d241b!important;outline-offset:3px!important;box-shadow:0 0 20px #7b2c1e17!important}
.ink-edition .carousel-item.gamepadFocused{outline:0!important;box-shadow:none!important}
.ink-edition .carousel-item.gamepadFocused::after{content:'';position:absolute;bottom:13%;left:35%;right:30%;height:1px;background:#7b2015b0}
#inkCurtain{position:absolute;inset:0;z-index:130;pointer-events:none;opacity:0;background:#eeeae1;transition:opacity .17s ease}
.ink-leaving #inkCurtain{opacity:.82}
.ink-entering #inkCurtain{opacity:0;transition:opacity .32s ease}
.ink-entering .ink-page.active .ink-content,.ink-entering .ink-page.active .ink-settings{animation:inkContentIn .32s ease both}
@keyframes inkContentIn{from{opacity:.3;transform:translateX(15px)}to{opacity:1;transform:translateX(0)}}
.ink-edition #pageTurnLayer,.ink-edition #launchLayer{display:none!important}
.ink-edition #hud{z-index:9}
.ink-edition #overlay{position:absolute;inset:0;z-index:30;background:#eeeae3b8;backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;isolation:isolate;color:#141310}
.ink-edition #overlay.active{display:flex;animation:inkOverlayIn .32s ease both}
.ink-edition #overlay::before{content:'';position:absolute;inset:0;background:var(--pause-map) center/cover;filter:blur(3px) saturate(.48);opacity:.3;z-index:-1}
#inkPausePanel{position:relative;isolation:isolate;width:930px;height:550px;background:transparent;display:flex;align-items:center;flex-direction:column;box-sizing:border-box;padding:42px 88px 35px}
#inkPausePanel::before{content:"";position:absolute;inset:-12px;z-index:-1;pointer-events:none;background:#f6f3eb url('assets/ui-v6/pause-frame.png') center/100% 100%;-webkit-mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent),linear-gradient(to bottom,transparent,#000 7%,#000 93%,transparent);mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent),linear-gradient(to bottom,transparent,#000 7%,#000 93%,transparent);-webkit-mask-composite:source-in;mask-composite:intersect}
#inkPausePanel::after{content:"";position:absolute;inset:0;z-index:-2;pointer-events:none;background:#f6f3eb;filter:blur(22px);opacity:.45;border-radius:12%}
.ink-edition #overlay #ovTag{font-family:KaiTi,STKaiti,serif;font-size:66px;line-height:1.3;margin:0 0 8px;color:#0d0c0b;letter-spacing:7px;font-weight:bold;background:none;padding:0;border:0;transform:none;text-shadow:none}
.ink-edition #overlay.ink-pause #ovTag{width:300px;height:95px;flex-shrink:0;background:url('assets/ui-v6/reference-6.png') -493px -113px/1280px 659px;color:transparent;font-size:0;mix-blend-mode:multiply}
.ink-edition #overlay #ovTitle{font-size:43px;line-height:1.4;color:#10100e;margin:8px 0 4px;letter-spacing:4px;text-shadow:none;transform:none}
.ink-edition #overlay #ovSub{font-size:19px;font-weight:bold;letter-spacing:3px;color:#171411;margin:6px 0 24px}
.ink-edition #ovBtns{display:flex;gap:20px;justify-content:center;flex-wrap:nowrap;width:100%;margin:0 0 25px}
.ink-edition #ovBtns .btn,.ink-edition #btnBgmToggle,.ink-edition #cardBtns button{font-size:26px;letter-spacing:3px;padding:10px 22px;min-width:180px;border:2px solid #4e4640;border-radius:1px;background:#f8f6ef88;color:#171411;box-shadow:inset 0 0 0 2px #f4f0e7,inset 0 0 0 3px #51483c50;transform:none;clip-path:none;transition:background .2s,transform .2s}
.ink-edition #ovBtns .btn::before,.ink-edition #ovBtns .btn::after{display:none}
.ink-edition #ovBtns .btn.primary,.ink-edition #cardBtns #btnRefresh{background:linear-gradient(100deg,#76211d,#3c201c);color:#fff8ea;border-color:#74231d;clip-path:polygon(1% 4%,98% 0,100% 90%,96% 100%,0 97%);box-shadow:none}
.ink-edition #ovBtns .btn:hover,.ink-edition #cardBtns button:hover{transform:translateY(-2px)}
.ink-edition #audioRow{display:none;width:90%;align-items:center;justify-content:center;gap:18px;margin:0;color:#161411}
.ink-edition #audioRow.show{display:flex}
.ink-edition #audioRow .auLabel{font-size:24px;letter-spacing:3px;color:#171411}
.ink-edition #volRange{width:285px}
.ink-edition #btnBgmToggle{font-size:21px;min-width:135px;padding:8px 12px;margin-left:10px}
.ink-edition #nightPauseRow{margin-top:20px;gap:20px;width:100%;justify-content:center}
.ink-edition .nightMapToggle{color:#181612;border:1px solid #5e554a;background:#f6f2e866;border-radius:0;padding:5px 12px;font-size:18px;box-shadow:none;gap:12px}
.ink-edition .nightSwitchTrack{width:46px;height:23px;background:#393936;border-radius:20px;border:0}
.ink-edition .nightSwitchTrack::before{width:19px;height:19px;top:2px;left:2px;background:#eeece6;box-shadow:none}
.ink-edition .nightMapToggle[aria-pressed="true"] .nightSwitchTrack{background:#76231d}
.ink-edition .nightMapToggle[aria-pressed="true"] .nightSwitchTrack::before{transform:translateX(23px)}
.ink-edition .nightModeHint{color:#635a50;font-size:16px}
.ink-edition #cardLayer{position:absolute;inset:0;z-index:25;display:none;align-items:center;justify-content:flex-start;background:#eeeae2c9;padding:0;isolation:isolate;color:#171411;backdrop-filter:blur(3px)}
.ink-edition #cardLayer.active{display:flex;animation:inkOverlayIn .3s ease both}
.ink-edition #cardLayer::before{content:'';position:absolute;inset:0;background-image:var(--cardBg);background-size:cover;background-position:center;filter:blur(2px) saturate(.35);opacity:.32;z-index:-2;transform:none}
.ink-edition #cardLayer::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#f6f2e649,transparent,#f6f2e64a);pointer-events:none;z-index:-1}
.ink-edition #cardHead{position:relative;margin:32px 0 0;width:430px;height:100px;flex-shrink:0;background:url('assets/ui-v6/reference-5.png') -434px -43px/1280px 659px;font-size:0;color:transparent;mix-blend-mode:multiply}
.ink-edition #cardSub{margin:5px 0 20px;font-size:18px;letter-spacing:3px;color:#141210;font-weight:bold}
.ink-edition #cardRow{display:flex;gap:28px;justify-content:center;width:100%;height:365px;margin:0}
.ink-edition .upCard{position:relative;box-sizing:border-box;width:270px;height:365px;background:#f6f3eb url('assets/ui-v6/card-frame.png') center/100% 100%;border:0;box-shadow:none;border-radius:0;clip-path:none;color:#171411;padding:43px 34px 25px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;cursor:pointer;transition:transform .22s,filter .22s;animation:inkCardIn .38s both;animation-delay:calc(var(--card-index,0)*65ms);transform:none}
.ink-edition .upCard:nth-child(2){background-position:center;filter:none}
.ink-edition .upCard:nth-child(3){background-position:center}
.ink-edition .upCard:hover,.ink-edition .upCard.gamepadFocused{transform:translateY(-6px)!important;filter:drop-shadow(0 7px 7px #4d34201f)}
.ink-edition .upCard::before,.ink-edition .upCard::after,.ink-edition .upCard .cCorner{display:none!important}
.ink-edition .upCard .cRare{font-size:18px;line-height:24px;letter-spacing:7px;color:#171411;font-weight:bold;margin-bottom:12px;padding:0;background:none;border:0}
.ink-edition .upCard .cName{font-size:52px;line-height:1.3;letter-spacing:3px;color:#11100f;text-shadow:none;margin:0 0 11px;font-weight:bold;white-space:nowrap}
.ink-edition .upCard .cVal{font-size:17px;letter-spacing:2px;font-weight:bold;color:#25211b;background:#a59b8e26;border-radius:40%;padding:5px 14px;white-space:nowrap}
.ink-edition .upCard .cLine{width:88%;height:1px;background:#4d433351;margin:22px 0 18px}
.ink-edition .upCard .cDesc{font-size:20px;font-weight:bold;line-height:1.6;letter-spacing:2px;text-align:center;color:#12110f;margin:0}
.ink-edition #cardBtns{display:flex;gap:35px;margin:21px 0 0}
.ink-edition #cardBtns button{min-width:180px;font-size:23px;padding:8px 22px}
.ink-edition #cardBtns #btnRefresh{min-width:235px}
.ink-edition #btnRefresh:disabled{opacity:.4;filter:grayscale(1)}
.ink-edition .gestureSheet,.ink-edition .gamepadSheet{background:#f5f1e8;color:#25221c;border:1px solid #5d5140;box-shadow:0 20px 80px #0005}
.ink-edition #gamepadBadge,.ink-edition #gestureBadge{z-index:20;background:#f8f3e6db;border-color:#6f5b42;color:#4d332b;font-family:KaiTi,STKaiti,serif;box-shadow:none}
.ink-edition[data-ink-view="menu"] #gamepadBadge,.ink-edition[data-ink-view="menu"] #gestureBadge,.ink-edition[data-ink-view="saves"] #gamepadBadge,.ink-edition[data-ink-view="select"] #gamepadBadge,.ink-edition[data-ink-view="settings"] #gamepadBadge{display:none!important}
.ink-edition[data-ink-view="menu"] #gestureMovePad,.ink-edition[data-ink-view="settings"] #gestureMovePad,.ink-edition[data-ink-view="saves"] #gestureMovePad,.ink-edition[data-ink-view="select"] #gestureMovePad{display:none!important}
@keyframes inkOverlayIn{from{opacity:0}to{opacity:1}}
.ink-edition #cardLayer{gap:0}
.ink-edition #cardHead{height:88px}
.ink-edition #overlay #ovTag{font-family:EgretBrush,KaiTi,STKaiti,serif}
.ink-heading{mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.map-night .ink-edition .ink-page{background-color:#23333d!important;background-blend-mode:multiply;color:#ece7dc}
.map-night .ink-edition .ink-back,.map-night .ink-edition .carousel-item,.map-night .ink-edition .setting-row{color:#ece7dc}
.map-night .ink-edition .ink-heading{filter:invert(1);mix-blend-mode:screen;opacity:.9}
.map-night .ink-edition .ink-enter,.map-night .ink-edition .exit-row{color:#ecafa0}
.map-night .ink-edition .selection-seal{border-color:#dfb4a4}.map-night .ink-edition .selection-seal::after{background:#dfb4a4}
.map-night .ink-edition .ink-rule span{background:#23333d;color:#e7d9c1}
.map-night .ink-edition .setting-row .ink-small{color:#d9cbb9}
.map-night .ink-edition #inkPausePanel::before,.map-night .ink-edition .upCard{background-color:#23333d;background-blend-mode:multiply}
.map-night .ink-edition #inkPausePanel::after{background:#23333d}
.map-night .ink-edition #overlay::before,.map-night .ink-edition #cardLayer::before{filter:blur(3px) saturate(.4) brightness(.4)}
.map-night .ink-edition #overlay,.map-night .ink-edition #cardLayer{background-color:#10202bcb}
.map-night .ink-edition #overlay #ovTag,.map-night .ink-edition #cardHead{filter:invert(1);mix-blend-mode:screen}
.map-night .ink-edition #overlay #ovTitle,.map-night .ink-edition #overlay #ovSub,.map-night .ink-edition #cardSub,.map-night .ink-edition .upCard .cRare,.map-night .ink-edition .upCard .cName,.map-night .ink-edition .upCard .cVal,.map-night .ink-edition .upCard .cDesc,.map-night .ink-edition #audioRow .auLabel,.map-night .ink-edition .nightModeHint{color:#eee6d6}
.map-night .ink-edition #ovBtns .btn:not(.primary),.map-night .ink-edition #btnBgmToggle,.map-night .ink-edition #cardSkip,.map-night .ink-edition .nightMapToggle{background:#27363d;color:#eee6d6;border-color:#9a8b76;box-shadow:none}
.ink-edition .gamepadSheet p,.ink-edition .gamepadSheet label,.ink-edition .gamepadSheet small,.ink-edition .gamepadSheet #gamepadStatus,.ink-edition .gamepadSheet #gamepadMapping,.ink-edition .gestureSheet p,.ink-edition .gestureSheet small,.ink-edition .gestureSheet label{color:#55493c}
.ink-edition .gamepadKeys b,.ink-edition .gestureRules b,.ink-edition .gestureKey,.ink-edition .gestureEyebrow{color:#7c2d22}
@keyframes inkCardIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
/* Real video lettering is sampled onto a small, feathered magnifier surface. */
.ink-edition .homeHotspot{--home-proximity:0;--home-scale:1}
.ink-edition .homeHotspot::after{display:none!important}
.ink-edition .homeHotspot::before{opacity:calc(var(--home-proximity)*.9)!important;background:radial-gradient(ellipse,#8f382817,transparent 72%)!important}
.homeInkSurface{position:absolute;inset:-8px -10px;display:none;pointer-events:none;transform:scale(var(--home-scale));transform-origin:center;will-change:transform}
.ink-sampled .homeInkSurface{display:block}
.homeInkSurface canvas{position:absolute;inset:0;width:100%;height:100%;background:transparent;box-shadow:none;cursor:inherit;pointer-events:none}
.homeInkPaper{mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent),linear-gradient(0deg,transparent,#000 10%,#000 90%,transparent);mask-composite:intersect}
.homeInkSurface .homeInkLetters{opacity:calc(var(--home-proximity)*.62);filter:url(#homeInkLetterFilter) drop-shadow(0 0 2px #e8b56d) drop-shadow(0 0 7px #e1ae6860)}
#homeInkFilters{position:absolute;pointer-events:none;overflow:hidden}
/* Incoming panels travel right -> left; outgoing panels travel left -> right. */
.ink-edition #inkCurtain{display:none!important}
.ink-edition.ink-leaving #screen-menu.active,.ink-edition.ink-leaving .ink-page.active,.ink-edition.ink-leaving #overlay.active,.ink-edition.ink-leaving #cardLayer.active{animation:inkSlideOut .29s cubic-bezier(.4,0,.8,.5) both!important;will-change:transform,opacity}
.ink-edition.ink-entering #screen-menu.active,.ink-edition.ink-entering .ink-page.active,.ink-edition.ink-entering #overlay.active,.ink-edition.ink-entering #cardLayer.active{animation:inkSlideIn .42s cubic-bezier(.16,.8,.2,1) both!important;will-change:transform,opacity}
.ink-edition.ink-entering .ink-page.active .ink-content,.ink-edition.ink-entering .ink-page.active .ink-settings{animation:none}
.ink-edition #overlay.active,.ink-edition #cardLayer.active{animation:inkSlideIn .42s cubic-bezier(.16,.8,.2,1) both}
@keyframes inkSlideIn{from{transform:translateX(100%);opacity:.75}to{transform:translateX(0);opacity:1}}
@keyframes inkSlideOut{from{transform:translateX(0);opacity:1}to{transform:translateX(100%);opacity:.4}}
/* Rarity fire stays on the frame. The paper and all card text remain unfiltered. */
.ink-edition .upCard{isolation:isolate;--rarity-rgb:69,144,218;--rarity-ink:#2669a3}
.ink-edition .upCard.rare-稀有{--rarity-rgb:164,99,222;--rarity-ink:#8348b2}
.ink-edition .upCard.rare-史诗{--rarity-rgb:224,69,59;--rarity-ink:#a62f2a}
.ink-edition .upCard .cRare{color:var(--rarity-ink);text-shadow:0 0 8px rgba(var(--rarity-rgb),.16)}
.ink-edition .upCard>.cRare,.ink-edition .upCard>.cName,.ink-edition .upCard>.cVal,.ink-edition .upCard>.cLine,.ink-edition .upCard>.cDesc{position:relative;z-index:2}
.ink-edition .upCard .cDesc{font-size:19px;line-height:1.55;letter-spacing:1px}
.ink-edition .upCard[data-card-id="hit-slow"] .cDesc{font-size:16px;line-height:1.5}
.rarityAura{position:absolute;inset:0;z-index:1;pointer-events:none;border:1px solid rgba(var(--rarity-rgb),.45);box-shadow:0 0 10px rgba(var(--rarity-rgb),.25),inset 0 0 14px rgba(var(--rarity-rgb),.13)}
.rarityAura::before,.rarityAura::after{content:"";position:absolute;inset:-7px;pointer-events:none;background:radial-gradient(ellipse at 0 70%,rgba(var(--rarity-rgb),.4),transparent 18%),radial-gradient(ellipse at 100% 35%,rgba(var(--rarity-rgb),.35),transparent 17%),linear-gradient(0deg,rgba(var(--rarity-rgb),.48),transparent 12%,transparent 92%,rgba(var(--rarity-rgb),.22));filter:blur(5px);animation:rarityFlame 2.4s ease-in-out infinite alternate}
.rarityAura::after{inset:-3px;opacity:.55;animation-delay:-1.1s;animation-direction:alternate-reverse}
.rare-稀有 .rarityAura::before{animation-duration:1.9s}
.rare-史诗 .rarityAura::before{animation-duration:1.5s}
.rarityEmber{position:absolute;left:var(--ember-x);bottom:5%;width:3px;height:12px;border-radius:80% 0 75% 20%;background:rgba(var(--rarity-rgb),.85);box-shadow:0 0 6px rgba(var(--rarity-rgb),.5);animation:rarityEmber 2.6s ease-out infinite;animation-delay:var(--ember-delay);opacity:0}
@keyframes rarityFlame{from{opacity:.45;transform:translateY(2px) scaleX(.99)}to{opacity:.9;transform:translateY(-3px) scaleX(1.018)}}
@keyframes rarityEmber{0%{transform:translate(0,0) scale(.5);opacity:0}20%{opacity:.7}75%{opacity:.3}100%{transform:translate(6px,-70px) scale(.12);opacity:0}}
.map-night .ink-edition .upCard .cRare{color:rgb(var(--rarity-rgb))}
@media(prefers-reduced-motion:reduce){.ink-edition *{animation-duration:.001ms!important;transition-duration:.001ms!important}}
@media(prefers-reduced-motion:reduce){.rarityEmber{display:none}.rarityAura::before,.rarityAura::after{animation:none;opacity:.55}}
</style>
<link rel="stylesheet" href="css/battle_ui.css">
</head>
<body>
<div id="wrap" inert>
  <canvas id="game" width="1280" height="640"></canvas>
  <div id="vignette"></div>
  <div id="hud">
    <div id="stats">
      <div id="statName">厦门白鹭 · 鹭岛行</div>
      <div class="bar"><div id="hpFill" class="fill" style="width:100%"></div><div class="barNum" id="hpNum">100/100</div></div>
      <div class="bar"><div id="mpFill" class="fill" style="width:100%"></div><div class="barNum" id="mpNum">100/100</div></div>
      <div id="aspeed">蓝耗 12/砍 · 回蓝 20/秒</div>    </div>
    <div id="kills">0 / 0</div>
    <div id="lvlBuffs"></div>
    <div id="combo">COMBO 0</div>
    <div id="waveTitle"></div>
    <div id="tip">WASD移动 · 右键=闪击(30蓝) · 鼠标指向=面朝方向 · 左键=挥砍(12蓝)</div>
    <button id="btnPause">暂停</button>
  </div>

<svg id="homeClipDefs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><clipPath id="homeBodyClip" clipPathUnits="objectBoundingBox"><path id="homeBodyClipPath" clip-rule="evenodd" d="M0 0H1V1H0Z"/></clipPath></defs></svg>
  <!-- 首页 · 鹭岛深海航站 -->
  <div class="screen active" id="screen-menu">
    <canvas id="menuScene" width="1280" height="640" aria-hidden="true"></canvas>
    <header class="homeTop">
      <div class="homeBrand">
        <svg viewBox="0 0 40 32" aria-hidden="true"><path d="M3 25 17 17 7 4 24 14 35 7 27 19 37 22 23 23 18 30 17 22 3 25Z"/><path d="m17 17 7-3 3 5M7 4l16 19"/></svg>
        <div>鹭岛 · 潮汐航站<small>EGRET / TIDAL FRONTIER</small></div>
      </div>
      <div class="homeLocation">XIAMEN<span>厦门 · 海岸战线</span></div>
    </header>
    <div class="homeTitle">
      <div class="homeEyebrow">RIDE THE TIDE</div>
      <h1 aria-label="白鹭击浪"><span>白鹭</span><span>击<i>浪</i></span></h1>
      <p>御剑入海 · 逐浪而行</p>
      <div class="titleRule">EGRET STRIKE / 01</div>
    </div>
    <div class="heroStage" aria-hidden="true">
      <div class="heroHalo"></div>
      <div class="heroFloat"><img id="menuHero" alt=""><canvas id="homeSword" width="310" height="520" aria-hidden="true"></canvas></div>
      <div class="heroCoordinate">TIDAL SWORDSMAN / 鹭岛行者</div>
      <div class="heroFootnote">白鹭 / EGRET–01</div>
    </div>
    <canvas id="swordAura" width="1280" height="640" aria-hidden="true"></canvas>
    <canvas id="arrivalParticles" width="1280" height="640" aria-hidden="true"></canvas>
    <nav class="navDock" aria-label="游戏主菜单">
      <div class="dockHeading"><span>01 / 出航</span><span>CONTROL</span></div>
      <div class="dockItem">
        <button class="sciButton primary" id="btnStart" aria-label="开始游戏"><span><strong>开始游戏</strong><small>ENTER THE TIDE</small></span><span class="buttonArrow" aria-hidden="true">↗</span></button>
      </div>
      <div class="dockItem">
        <button class="sciButton" id="btnSense" aria-label="体感模式"><span><strong>体感模式</strong><small>MOTION CONTROL</small></span><span class="buttonArrow" aria-hidden="true">⌁</span></button>
      </div>
      <div class="dockAux">
        <button id="btnDownload"><span aria-hidden="true">↓</span>下载游戏包</button>
        <button id="btnQuit"><span aria-hidden="true">↗</span>退出游戏</button>
      </div>
      <div class="dockNote">选择航线，向浪而行。</div>
    </nav>
    <div class="saveRowArt">
      <span class="saveTag">ARCHIVE</span>
      <input id="saveName" aria-label="存档名称" maxlength="12" placeholder="为这次航行命名" />
      <button class="abtn tiny" id="btnSave">存档</button>
      <button class="abtn tiny" id="btnSaves">存档处</button>
      <button class="abtn tiny" id="btnExport">导出</button>
    </div>
    <div class="homeFooter">WASD · 移动 / 鼠标 · 挥剑<br>白鹭击浪 · XIAMEN</div>
    <div class="note" id="senseNote" role="status" aria-live="polite"></div>
  </div>

  <!-- 选关页 -->
  <div class="screen" id="screen-select">
    <div class="selHead">选 择 关 卡</div>
    <div class="selSub">沿 鹭 岛 海 岸 · 依 次 击 浪</div>
    <div class="lvGridWrap"><div class="lvGrid" id="lvGrid"></div></div>
    <div class="routeFooter"><button class="btn" id="btnSelBack">返回主页面</button><div id="routeCaption" aria-live="polite"></div></div>
  </div>

  <!-- 存档处：读档 / 新建存档（每个存档记录已获得的强化 buff） -->
  <div class="screen" id="screen-saves">
    <div class="selHead">存 档 处</div>
    <div class="saveList" id="saveList"></div>
    <div class="saveNewRow">
      <input id="newSaveName" maxlength="12" placeholder="新存档名（如：鹭岛1）" />
      <button class="abtn tiny" id="btnNewSave">新建存档 · 从头开始</button>
    </div>
    <button class="btn" id="btnSavesBack">返回主页面</button>
    <div class="note"></div>
  </div>

  <!-- 覆盖层：暂停 / 结算 -->
  <div id="overlay">
    <div id="ovTag"></div>
    <div id="ovTitle"></div>
    <div id="ovSub"></div>
      <div id="ovBtns"></div>
      <div id="audioRow"></div>
    </div>

  <!-- 升级卡片层 -->
  <div id="cardLayer">
    <div id="cardHead">升 级 选 择</div>
    <div id="cardSub">选一张强化，继续迎战</div>
    <div id="cardRow"></div>
    <div id="cardBtns">
      <button class="btn small" id="btnRefresh">刷新 (2 次)</button>
      <button class="btn small" id="cardSkip">放弃强化</button>
    </div>
  </div>
  <!-- 翻页快照层与墨水晕染层：仅过渡期间拦截输入 -->
  <div id="pageTurnLayer" aria-hidden="true">
    <div class="pageShade"></div>
    <div class="pageSheet"><div class="pageFace pageFront"></div><div class="pageFace pageBack"></div></div>
  </div>
  <div id="inkLayer" aria-hidden="true"><canvas id="inkBloomCanvas" width="640" height="320"></canvas></div>
  <div id="launchLayer" aria-hidden="true"><canvas id="launchCanvas" width="1280" height="640"></canvas></div>
  <!-- ★ 版本/诊断角标：卡住时截图会自带现场信息 -->
  <div id="dbg"></div>
</div>
<script src="js/00_world_data.js"></script>
<script src="js/00_world.js"></script>
<script src="js/00_atlas_data.js"></script>
<script src="js/12_sprites.js"></script>
<script src="js/01_game_main.js"></script>
<script src="js/02_game_bridge.js"></script>
<script async src="https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/hands.js" crossorigin="anonymous" onerror="window.__egretMediaPipeLoadFailed=true"></script>
<script src="js/03_combat_feedback.js"></script>
<script src="js/04_ink_attack.js"></script>
<script src="js/05_gesture_engine.js"></script>
<script src="js/06_gesture_ui.js"></script>
<script src="js/07_pad_core.js"></script>
<script src="js/08_pad_nav.js"></script>
<script src="js/09_pad_ui.js"></script>
<script src="js/10_menu_magnifier.js"></script>
<script src="js/11_v6_cinema.js"></script>
</body>
</html>
